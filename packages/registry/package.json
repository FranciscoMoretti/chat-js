{
  "name": "@chat-js/registry",
  "version": "0.1.2",
  "private": false,
  "description": "ChatJS tool and gateway registry items",
  "keywords": [
    "ai",
    "chatjs",
    "registry",
    "tools"
  ],
  "homepage": "https://github.com/FranciscoMoretti/chat-js/tree/main/packages/registry",
  "bugs": {
    "url": "https://github.com/FranciscoMoretti/chat-js/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoMoretti/chat-js.git",
    "directory": "packages/registry"
  },
  "files": [
    "dist/r"
  ],
  "type": "module",
  "exports": {
    "./r/*": "./dist/r/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/generate-composer-icons.ts && bun build.ts",
    "prepublishOnly": "bun run build",
    "test:types": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test:unit": "bun test src",
    "test:visual": "vitest run --config visual/vitest.config.ts",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "demo:check": "bun test test/demo-check.test.ts",
    "demo:sync": "bun scripts/demo-sync.ts"
  },
  "dependencies": {},
