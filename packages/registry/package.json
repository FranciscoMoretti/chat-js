{
  "name": "@chat-js/registry",
  "version": "0.2.0-beta.11",
  "private": false,
  "description": "ChatJS tool and gateway registry items",
  "keywords": [
    "ai",
    "chatjs",
    "registry",
    "tools"
  ],
  "homepage": "https://github.com/FranciscoMoretti/chat-js/tree/main/packages/registry",
  "bugs": {
    "url": "https://github.com/FranciscoMoretti/chat-js/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoMoretti/chat-js.git",
    "directory": "packages/registry"
  },
  "files": [
    "dist/r"
  ],
  "type": "module",
  "exports": {
    "./r/*": "./dist/r/*.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "bun scripts/generate-composer-icons.ts && bun build.ts",
    "prepublishOnly": "bun run build",
    "test:types": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test:unit": "bun test src",
    "test:native": "bun run build && bun test --timeout 180000 test/native-eve.test.ts",
    "test:installation": "bunx turbo run build --filter=@chat-js/thread && bun run --cwd ../cli template:sync && bun test --timeout 60000 test/installation-validation.test.ts",
    "profile:validation": "bun scripts/validation-profile.ts",
    "test:visual": "vitest run --config visual/vitest.config.ts",
    "check": "bun run test:types && bun run test:unit && bun run test:visual",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "demo:check": "bun test test/demo-check.test.ts",
    "demo:sync": "bun scripts/demo-sync.ts"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.104",
    "@ai-sdk/gateway": "4.0.145",
    "@ai-sdk/google": "4.0.120",
    "@ai-sdk/mcp": "2.0.99",
    "@ai-sdk/openai": "4.0.117",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@ai-sdk/provider": "4.0.38",
    "@better-auth/electron": "1.6.2",
    "@chat-js/registry-validation": "workspace:*",
    "@hookform/resolvers": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/storage-js": "2.117.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@types/bun": "latest",
    "@types/node": "22.13.10",
    "@types/papaparse": "^5.3.15",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vercel/blob": "2.4.0",
    "@vercel/oidc": "3.2.0",
    "ai": "7.0.172",
    "ajv": "8.18.0",
    "basic-ftp": "^5.0.5",
    "better-auth": "1.6.2",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "eve": "npm:@chat-js/eve@1.1.1-chatjs.0",
    "files-sdk": "2.5.0",
    "geist": "^1.7.2",
    "guarded-fetch": "^0.1.4",
    "katex": "0.16.45",
    "lucide-react": "0.553.0",
    "motion": "^12.23.24",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.5",
    "oxfmt": "0.71.0",
    "papaparse": "^5.5.2",
    "postgres": "^3.4.4",
    "react": "19.2.3",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.17",
    "shadcn": "4.21.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.2",
    "typescript": "6.0.2",
    "ultracite": "8.0.0",
    "vite": "8.1.4",
    "zod": "4.5.4"
  }
}
