    "@lexical/rich-text": "^0.32.1",
    "@mendable/firecrawl-js": "1.29.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@tanstack/react-query": "^5.80.3",
