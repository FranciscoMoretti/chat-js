{
  "name": "@chat-js/registry",
  "version": "1.0.0",
  "private": false,
  "description": "ChatJS tool and gateway registry items",
  "keywords": [
    "ai",
    "chatjs",
    "registry",
    "tools"
  ],
  "homepage": "https://github.com/FranciscoMoretti/chat-js/tree/main/packages/registry",
  "bugs": {
    "url": "https://github.com/FranciscoMoretti/chat-js/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoMoretti/chat-js.git",
    "directory": "packages/registry"
  },
  "files": [
    "dist/r"
  ],
  "type": "module",
  "exports": {
    "./r/*": "./dist/r/*.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.ts",
    "prepublishOnly": "bun run build",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test src",
    "test:visual": "vitest run --config visual/vitest.config.ts",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/gateway": "4.0.75",
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.59",
    "@ai-sdk/openai-compatible": "3.0.44",
    "@ai-sdk/provider": "4.0.10",
    "@chat-js/gateways": "workspace:*",
    "@mendable/firecrawl-js": "1.29.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@tavily/core": "^0.3.3",
    "@types/bun": "latest",
    "@types/node": "22.13.10",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vercel/sandbox": "^1.0.2",
    "ai": "7.0.93",
    "basic-ftp": "^5.0.5",
    "date-fns": "^4.1.0",
    "echarts": "6.0.0",
    "files-sdk": "2.1.0",
    "lucide-react": "0.553.0",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "shadcn": "4.21.0",
    "typescript": "6.0.2",
    "zod": "^4.3.6"
  }
}
