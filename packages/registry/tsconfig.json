{
  "extends": "../../apps/chat/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "next"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../../apps/chat/*"],
      "drizzle-orm": ["../../apps/chat/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../../apps/chat/node_modules/drizzle-orm/*"]
    }
  },
  "include": [
    "registry.ts",
    "metadata.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../apps/chat/types/**/*.d.ts",
    "../../apps/chat/electron.d.ts",
    "visual/**/*.ts",
    "visual/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
