{
  "extends": "../../apps/chat/tsconfig.json",
  "compilerOptions": {
    "types": [
      "bun",
      "node",
      "next"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "../../apps/chat/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../apps/chat/types/**/*.d.ts",
    "../../apps/chat/electron.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
