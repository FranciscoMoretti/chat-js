{
  "name": "@chat-js/gateways",
  "version": "0.2.0",
  "description": "Gateway contracts and shared runtime utilities for ChatJS registry extensions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranciscoMoretti/chat-js.git",
    "directory": "packages/gateways"
  },
  "files": [
    "dist",
    "src",
    "!src/*.test.ts",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "bun": "./src/defaults.ts",
      "development": "./src/defaults.ts",
      "default": "./dist/defaults.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "bun": "./src/models.ts",
      "development": "./src/models.ts",
      "default": "./dist/models.js"
    },
    "./gateway-provider": {
      "types": "./dist/gateway-provider.d.ts",
      "bun": "./src/gateway-provider.ts",
      "development": "./src/gateway-provider.ts",
      "default": "./dist/gateway-provider.js"
    },
    "./provider-options": {
      "types": "./dist/provider-options.d.ts",
      "bun": "./src/provider-options.ts",
      "development": "./src/provider-options.ts",
      "default": "./dist/provider-options.js"
    },
    "./package.json": "./package.json",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "bun": "./src/runtime.ts",
      "development": "./src/runtime.ts",
      "default": "./dist/runtime.js"
    },
    "./provider-types": {
      "types": "./dist/provider-types.d.ts",
      "bun": "./src/provider-types.ts",
      "development": "./src/provider-types.ts",
      "default": "./dist/provider-types.js"
    },
    "./definition": {
      "types": "./dist/definition.d.ts",
      "bun": "./src/definition.ts",
      "development": "./src/definition.ts",
      "default": "./dist/definition.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test:types": "bun run build && tsc --noEmit",
    "test:unit": "vitest run",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt --write .",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/gateway": "4.0.75",
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.59",
    "@ai-sdk/openai-compatible": "3.0.44",
    "@ai-sdk/provider": "4.0.10",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@types/node": "^22.8.6",
    "ai": "7.0.93",
    "typescript": "6.0.2",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "4.0.10",
    "ai": "7.0.93"
  }
}
