{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "fixture/**/*.ts",
    "dynamic/template/**/*.ts",
    "dynamic/prepare.mjs"
  ]
}
