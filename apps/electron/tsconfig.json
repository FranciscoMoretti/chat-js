{
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["bun", "node"],
    "paths": {
      "@/*": ["../chat/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "scripts/**/*.cjs",
    "../chat/next-env.d.ts",
    "../chat/electron.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
