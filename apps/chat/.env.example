# [required] Generate: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=


# Postgres setup: https://www.chatjs.dev/docs/reference/database
# Verify configured connections with: bun db:connect
# [required] Postgres connection URL from your database host
DATABASE_URL=
# [optional] Direct connection for migrations and Drizzle schema operations
# Falls back to DATABASE_URL when omitted
DATABASE_MIGRATION_URL=
# Disable for transaction poolers that do not support prepared statements
DATABASE_PREPARE=true
# [optional] Runtime connections per app process (driver default when omitted)
DATABASE_MAX_CONNECTIONS=

# Required EVE runtime configuration (Node 24+).
# Generate independently from AUTH_SECRET: openssl rand -base64 32
EVE_GATEWAY_SECRET=
# [local/self-hosted only] PostgreSQL database for durable workflows.
# Vercel Preview/Production use managed Workflow automatically; omit this there.
# Local/self-hosted: defaults to DATABASE_URL.
# Requires a direct/session connection. Unused on Vercel.
WORKFLOW_POSTGRES_URL=
# Application gateway origin serving /eve/chat/v1
# HTTPS required except for loopback HTTP (localhost, 127.0.0.0/8, [::1]).
# Private-network workers also require HTTPS.
# Optional: defaults to VERCEL_URL, APP_URL, or localhost with PORT.
EVE_INTERNAL_ORIGIN=
# Protected Vercel previews require Protection Bypass for Automation enabled.
# Vercel injects VERCEL_AUTOMATION_BYPASS_SECRET; never expose it to the browser.
# Guest admissions enforce configured credits and request limits.
# Retention additionally requires a cleanup schedule and verified lifecycle support.

# <chatjs-gateway-provider>
# Installed Vercel AI Gateway. Replace source with: chat-js add --gateway <provider> --replace
# Use AI_GATEWAY_API_KEY locally or runtime Vercel OIDC on Vercel.
AI_GATEWAY_API_KEY=
# </chatjs-gateway-provider>

# <chatjs-storage-provider>
# Vercel Blob — Vercel Blob. Prefers Vercel OIDC (VERCEL_OIDC_TOKEN + BLOB_STORE_ID, auto-rotating) and falls back to BLOB_READ_WRITE_TOKEN; pass token, oidcToken, or storeId manually for local dev or other hosts.
# Credential option: Read-write token
# Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=
# Credential option: Vercel OIDC (auto-rotating)
# Vercel OIDC token (auto-injected on Vercel)
VERCEL_OIDC_TOKEN=
# Blob store ID
BLOB_STORE_ID=
# Note: An explicit `token` wins over OIDC. Locally, set BLOB_READ_WRITE_TOKEN.
# </chatjs-storage-provider>

# [required for non-Vercel] Your app's public URL (e.g., https://myapp.com)
# On Vercel previews, defaults to the stable VERCEL_BRANCH_URL.
# Other Vercel deployments fall back to VERCEL_URL.
APP_URL="http://localhost:3000"

# --- Auth (pick ≥1) ---
# Google — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub — https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Vercel - https://vercel.com/docs/sign-in-with-vercel
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=


# [optional] Protect the cleanup endpoint when a cleanup schedule is configured.
CRON_SECRET=

# <chatjs-installed-capabilities>
# Credentials for the demo's installed tools and features. Fill applicable alternatives.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
MCP_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional Langfuse endpoint, when Langfuse is installed:
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Vercel Sandbox alternative to runtime OIDC:
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
# </chatjs-installed-capabilities>
