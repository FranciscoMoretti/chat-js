{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "Preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@eve-test/*": ["./node_modules/eve/*", "../../node_modules/eve/*"],
      "@world-postgres-test/*": [
        "./node_modules/@workflow/world-postgres/*",
        "../../node_modules/@workflow/world-postgres/*"
      ]
    },
    "strictNullChecks": true,
    "types": ["node"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/.eve/**", "**/.output/**"]
}
