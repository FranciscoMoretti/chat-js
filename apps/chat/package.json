{
  "name": "@chatjs/chat",
  "version": "0.2.1",
  "private": true,
  "license": "Apache-2.0",
  "imports": {
    "#query-devtools": {
      "development": "@tanstack/react-query-devtools",
      "default": "./lib/devtools-disabled.ts"
    }
  },
  "scripts": {
    "prebuild": "bun run check-env",
    "dev": "bun run check-env && EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} next dev",
    "dev:inspect": "bun run check-env && EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} next dev --inspect",
    "build": "tsx lib/db/migrate.ts --deployment && bun run eve:build && EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} next build",
    "analyze": "next experimental-analyze",
    "start": "EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} next start",
    "prod": "bun run build && bun run start",
    "lint": "next typegen . && ultracite check . --type-aware --report-unused-disable-directives-severity error",
    "format": "oxfmt --write .",
    "check-env": "bun scripts/check-env.ts",
    "cleanup": "node scripts/cleanup.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.generate.config.ts",
    "db:migrate": "bunx tsx lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:branch:use": "bash scripts/db-branch-use.sh",
    "db:branch:create": "bash scripts/db-branch-create.sh",
    "db:branch:delete": "bash scripts/db-branch-delete.sh",
    "db:branch:start": "bash -c 'N=${1:-dev-local}; bun db:branch:create $N && bun db:branch:use $N' --",
    "db:branch:stop": "bash -c 'N=${1:-dev-local}; bun db:branch:use main && bun db:branch:delete $N' --",
    "db:branch:list": "bunx neonctl branches list",
    "test": "bun test:e2e && bun test:unit",
    "test:e2e": "export PLAYWRIGHT=True && bunx playwright test --workers=4",
    "test:unit": "vitest run",
    "test:native": "vitest run --config vitest.eve-provider.config.ts",
    "test:research:native": "bun tests/native-research-runtime.ts",
    "test:types": "rm -rf .next/dev/types && next typegen . && tsc --noEmit",
    "test:worker-bundle": "node scripts/check-worker-typescript.ts",
    "dev:neon": "bash scripts/with-db.sh bun dev",
    "db:migrate:neon": "bash scripts/with-db.sh bun db:migrate",
    "db:connect": "bun scripts/check-db.ts",
    "eve:build": "EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} tsx scripts/build-eve.ts",
    "eve:start": "EVE_SANDBOX_IMAGE_TAG=${EVE_SANDBOX_IMAGE_TAG:-0.80.1} NODE_ENV=production eve start --host 127.0.0.1",
    "setup": "tsx scripts/eve-setup.ts --validate && tsx lib/db/migrate.ts && tsx scripts/eve-setup.ts",
    "eve:setup": "tsx scripts/eve-setup.ts",
    "eve:check": "tsx scripts/eve-setup.ts --check",
    "test:tools:live": "bunx --bun playwright test --config playwright.eve-live.config.ts eve-research.e2e.ts eve-code-execution.e2e.ts --grep \"native deep research|native code execution\""
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.145",
    "@ai-sdk/mcp": "2.0.99",
    "@ai-sdk/provider": "4.0.38",
    "@ai-sdk/provider-utils": "5.0.81",
    "@base-ui/react": "^1.9.0",
    "@better-auth/core": "1.6.2",
    "@better-auth/electron": "1.6.2",
    "@hookform/resolvers": "^5.2.1",
    "@lexical/react": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/storage-js": "2.117.2",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@trpc/tanstack-react-query": "^11.1.2",
    "@types/uuid": "^10.0.0",
    "@vercel/blob": "2.4.0",
    "@vercel/connect": "2.9.2",
    "@vercel/oidc": "3.2.0",
    "@workflow/world-postgres": "5.1.1",
    "ai": "7.0.172",
    "ajv": "8.18.0",
    "better-auth": "1.6.2",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "eve": "npm:@chat-js/eve@1.1.1-chatjs.0",
    "fast-deep-equal": "^3.1.3",
    "files-sdk": "2.5.0",
    "guarded-fetch": "^0.1.4",
    "katex": "0.16.45",
    "lexical": "^0.32.1",
    "lucide-react": "0.553.0",
    "motion": "^12.23.24",
    "nanoid": "^5.0.8",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.5",
    "papaparse": "^5.5.2",
    "pino": "^9.9.0",
    "postgres": "^3.4.4",
    "react": "19.2.3",
    "react-data-grid": "7.0.0-beta.47",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.0",
    "read-excel-file": "9.3.17",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "shiki": "^3.19.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tokenlens": "^1.3.1",
    "typescript": "6.0.2",
    "usehooks-ts": "^3.1.0",
    "uuid": "^11.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query-devtools": "^5.80.3",
    "@types/json-schema": "7.0.15",
    "@types/node": "^22.8.6",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "drizzle-kit": "^0.31.9",
    "just-bash": "^3.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.20.0",
    "pino-pretty": "^13.1.1",
    "postcss": "^8",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.3.7",
    "ultracite": "8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@vercel/connect": {
      "eve": "$eve"
    },
    "commander": "^14.0.0",
    "files-sdk": {
      "ai": "$ai"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
