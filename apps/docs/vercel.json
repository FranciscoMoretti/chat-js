{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "rm -rf node_modules && cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/"
    },
    {
      "source": "/docs/:match*",
      "destination": "/:match*"
    }
  ],
  "ignoreCommand": "node ../../scripts/docs-production.mjs ignore",
  "headers": [
    {
      "source": "/docs/deployment.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
