{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "EVE_INTERNAL_ORIGIN",
    "EVE_GATEWAY_SECRET",
    "WORKFLOW_POSTGRES_URL",
    "MSB_BACKEND",
    "MSB_HOME",
    "AUTH_SECRET",
    "BLOB_READ_WRITE_TOKEN",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "VERCEL_APP_CLIENT_ID",
    "VERCEL_APP_CLIENT_SECRET",
    "AI_GATEWAY_API_KEY",
    "VERCEL_OIDC_TOKEN",
    "OPENROUTER_API_KEY",
    "OPENAI_COMPATIBLE_BASE_URL",
    "OPENAI_COMPATIBLE_API_KEY",
    "OPENAI_API_KEY",
    "CRON_SECRET",
    "EXA_API_KEY",
    "FIRECRAWL_API_KEY",
    "MCP_ENCRYPTION_KEY",
    "VERCEL_TEAM_ID",
    "VERCEL_PROJECT_ID",
    "VERCEL_TOKEN",
    "VERCEL_SANDBOX_IMAGE_JAVASCRIPT",
    "VERCEL_SANDBOX_IMAGE_PYTHON",
    "APP_URL",
    "ELECTRON_APP_URL",
    "PORT",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "PLAYWRIGHT",
    "CI_PLAYWRIGHT",
    "PLAYWRIGHT_TEST_BASE_URL",
    "TRUSTED_CLIENT_IP_HEADER",
    "DAYTONA_API_KEY",
    "DAYTONA_ORGANIZATION_ID"
  ],
  "tasks": {
    "dev": {
      "passThroughEnv": ["PUBLIC_CHATJS_SITE_URL"],
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "build/**"
      ]
    },
    "@chatjs/chat#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "EVE_SANDBOX_IMAGE_TAG",
        "NEXT_DEPLOYMENT_ID",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY"
      ]
    },
    "@chatjs/chat#test": {
      "dependsOn": ["^test"],
      "cache": false
    },
    "site-source": {
      "dependsOn": ["^site-source"]
    },
    "@chatjs/site#build": {
      "dependsOn": ["^site-source", "@chat-js/thread#build"],
      "env": [
        "NEXT_DEPLOYMENT_ID",
        "NEXT_PUBLIC_*",
        "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
        "VERCEL",
        "VERCEL_ENV"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "@chatjs/site#dev": {
      "dependsOn": ["@chat-js/thread#build"],
      "cache": false,
      "persistent": true
    },
    "@chatjs/docs#build": {
      "env": ["CHATJS_DOCS_HISTORY"],
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.agents/skills/**"],
      "outputs": ["dist/**"]
    },
    "format": {
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:unit": {
      "dependsOn": ["^test:unit"]
    },
    "test:types": {
      "dependsOn": ["^test:types"]
    },
    "docs:links": {
      "cache": false
    },
    "@chatjs/chat#test:e2e": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "PLAYWRIGHT_BROWSERS_PATH",
        "EVE_ALLOW_REMOTE_DATABASE_TESTS",
        "EVE_TEST_DATABASE_URL"
      ],
      "cache": false
    },
    "electron:build": {
      "env": ["ELECTRON_APP_URL"],
      "cache": true,
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "icon.png",
        "scripts/**"
      ],
      "outputs": ["dist/**", "build/**"]
    },
    "electron:dev": {
      "cache": false,
      "persistent": true
    },
    "electron:publish": {
      "cache": false,
      "dependsOn": ["electron:build"]
    },
    "electron:make": {
      "cache": false,
      "dependsOn": ["electron:build"]
    },
    "chat-js#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/chat/**",
        "$TURBO_ROOT$/apps/electron/**",
        "$TURBO_ROOT$/scripts/sync-template.ts",
        "$TURBO_ROOT$/scripts/{dev-supervisor,dev-process-tree,dev-health,dev-recovery}.ts",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/scripts/sync-template-snapshot.ts",
        "$TURBO_ROOT$/package.json",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{node_modules,.next,.eve,.output,.turbo,build,dist,release,out,playwright,playwright-report,test-results,eve-results,blob-report}/**",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{.env,.env.*.local,.env.local,.DS_Store,*.tsbuildinfo,bun.lock,bun.lockb}",
        "!$TURBO_ROOT$/apps/electron/branding.json",
        "$TURBO_ROOT$/packages/registry/*.{ts,json}",
        "$TURBO_ROOT$/packages/registry/src/**",
        "$TURBO_ROOT$/packages/registry/build.ts",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ],
      "outputs": ["dist/**", "templates/**"]
    },
    "chat-js#test:unit": {
      "dependsOn": ["build"],
      "outputs": ["templates/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/chat/**",
        "$TURBO_ROOT$/apps/electron/**",
        "$TURBO_ROOT$/scripts/sync-template.ts",
        "$TURBO_ROOT$/scripts/{dev-supervisor,dev-process-tree,dev-health,dev-recovery}.ts",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/scripts/sync-template-snapshot.ts",
        "$TURBO_ROOT$/package.json",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{node_modules,.next,.eve,.output,.turbo,build,dist,release,out,playwright,playwright-report,test-results,eve-results,blob-report}/**",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{.env,.env.*.local,.env.local,.DS_Store,*.tsbuildinfo,bun.lock,bun.lockb}",
        "!$TURBO_ROOT$/apps/electron/branding.json",
        "$TURBO_ROOT$/packages/registry/*.{ts,json}",
        "$TURBO_ROOT$/packages/registry/src/**",
        "$TURBO_ROOT$/packages/registry/build.ts",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ]
    },
    "chat-js#test:scaffold": {
      "dependsOn": ["test:unit"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/cli-scaffold.yml",
        "$TURBO_ROOT$/packages/registry/scripts/**",
        "$TURBO_ROOT$/packages/registry/test/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ]
    },
    "@chat-js/registry#test:unit": {
      "dependsOn": ["^test:unit", "demo:check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/chat/**",
        "!$TURBO_ROOT$/apps/chat/**/{node_modules,.next,.eve,.output,.turbo,playwright-report,test-results,eve-results}/**",
        "!$TURBO_ROOT$/apps/chat/**/{.env*,*.tsbuildinfo}",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ]
    },
    "@chat-js/registry#test:types": {
      "dependsOn": ["^test:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json",
        "$TURBO_ROOT$/apps/chat/**",
        "!$TURBO_ROOT$/apps/chat/**/{node_modules,.next,.eve,.output,.turbo,playwright-report,test-results,eve-results}/**",
        "!$TURBO_ROOT$/apps/chat/**/{.env*,*.tsbuildinfo}",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ]
    },
    "chat-js#test:types": {
      "dependsOn": ["^test:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/chat/**",
        "$TURBO_ROOT$/apps/electron/**",
        "$TURBO_ROOT$/scripts/sync-template.ts",
        "$TURBO_ROOT$/scripts/{dev-supervisor,dev-process-tree,dev-health,dev-recovery}.ts",
        "$TURBO_ROOT$/patches/*.patch",
        "$TURBO_ROOT$/scripts/sync-template-snapshot.ts",
        "$TURBO_ROOT$/package.json",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{node_modules,.next,.eve,.output,.turbo,build,dist,release,out,playwright,playwright-report,test-results,eve-results,blob-report}/**",
        "!$TURBO_ROOT$/apps/{chat,electron}/**/{.env,.env.*.local,.env.local,.DS_Store,*.tsbuildinfo,bun.lock,bun.lockb}",
        "!$TURBO_ROOT$/apps/electron/branding.json",
        "$TURBO_ROOT$/packages/registry/*.{ts,json}",
        "$TURBO_ROOT$/packages/registry/src/**",
        "$TURBO_ROOT$/packages/registry/build.ts",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ]
    },
    "@chat-js/thread#test:types": {
      "dependsOn": ["^test:types"],
      "outputs": ["dist/**"]
    },
    "@chat-js/registry#demo:check": {
      "cache": true,
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/cli/src/**",
        "$TURBO_ROOT$/packages/cli/package.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/patches/**",
        "$TURBO_ROOT$/oxfmt.config.ts",
        "$TURBO_ROOT$/apps/chat/**",
        "!$TURBO_ROOT$/apps/chat/**/{node_modules,.next,.eve,.output,.turbo,build,dist,playwright,playwright-report,test-results,eve-results,blob-report}/**",
        "!$TURBO_ROOT$/apps/chat/**/{.env*,*.tsbuildinfo,.DS_Store,bun.lock,bun.lockb}",
        "$TURBO_ROOT$/packages/registry-validation/src/**",
        "$TURBO_ROOT$/packages/registry-validation/package.json"
      ],
      "outputs": []
    },
    "@chat-js/registry#demo:sync": {
      "cache": false,
      "outputs": []
    },
    "@chatjs/site#test:unit": {
      "dependsOn": [
        "^site-source",
        "@chat-js/thread#test:unit",
        "@chatjs/brand#test:unit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/registry/*.ts",
        "$TURBO_ROOT$/packages/registry/src/**",
        "$TURBO_ROOT$/apps/docs/**/*.mdx"
      ]
    }
  }
}
