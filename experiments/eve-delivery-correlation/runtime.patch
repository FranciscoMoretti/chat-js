+/** Experimental caller correlation, never authority or model context. */
+export function parseCorrelationId(value: unknown): string | undefined {
+  if (value === undefined) return undefined;
+  if (typeof value !== "string" || !/^[A-Za-z0-9_-]{1,128}$/.test(value)) {
+    throw new TypeError("correlationId must contain 1–128 ASCII letters, digits, underscores or hyphens");
+  }
+  return value;
+}
