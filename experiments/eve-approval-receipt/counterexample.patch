+      },
+      {
+        find: /^#(?<modulePath>.+)\.js$/u,
+        replacement: new URL("src/$1.ts", import.meta.url).pathname,
+      },
+    ],
+  },
+  test: {
+    environment: "node",
+    include: ["src/**/*.lane-b.integration.test.ts"],
+    setupFiles: ["./test/setup/mock-ai-gateway.ts"],
+    testTimeout: 30_000,
+  },
+});
