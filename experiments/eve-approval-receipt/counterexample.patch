+import { jsonSchema } from "ai";
+import { MockLanguageModelV4 } from "ai/test";
+import { expect, it, vi } from "vitest";
+import {
+  createApprovalContext,
+  usage,
+} from "#internal/testing/approval-resume.js";
+import { contextStorage } from "#context/container.js";
+import { createToolLoopHarness } from "#harness/tool-loop.js";
+import { createToolExecuteWithAuth } from "#execution/tool-auth.js";
+import type { HarnessSession } from "#harness/types.js";
+
+vi.mock("#runtime/attributes/emit.js", () => ({
+  setEveAttributes: vi.fn(async () => {}),
+}));
+const call = {
+  type: "tool-call" as const,
+  toolCallId: "call-1",
+  toolName: "mcp",
+  input: JSON.stringify({ value: 1 }),
+};
+const model = () => {
+  let count = 0;
+  return new MockLanguageModelV4({
+    provider: "eve-integration-mock",
+    modelId: "receipt",
+    // oxlint-disable-next-line eslint/require-await -- The SDK generator contract is asynchronous; this mock completes without external IO.
+    doGenerate: async () => {
+      count += 1;
+      return {
+        content:
+          count === 1 ? [call] : [{ type: "text" as const, text: "done" }],
+        finishReason: {
+          raw: undefined,
+          unified: count === 1 ? "tool-calls" : "stop",
+        },
+        usage,
+        warnings: [],
+      };
+    },
+  });
+};
+const session = (): HarnessSession => ({
+  sessionId: "generate-approval-resume-session",
+  continuationToken: "http:receipt",
+  agent: {
+    modelReference: { id: "receipt" },
+    system: "test",
+    tools: [
+      { name: "mcp", description: "test", inputSchema: { type: "object" } },
+    ],
+  },
+  history: [{ kind: "user", role: "user", content: "act" }],
+  compaction: { recentWindowSize: 10, threshold: 100_000 },
+});
+it.each([false, true])(
+  "false-to-true request/effect policy flip, final gate=%s",
+  async (gate) => {
+    let requireApproval = false;
+    const effect = vi.fn();
+    const policy = vi.fn(() => {
+      const decision = requireApproval ? "user-approval" : "not-applicable";
+      requireApproval = true;
+      return decision;
+    });
+    const execute = createToolExecuteWithAuth({
+      scope: "mcp",
+      execute: (_input, ctx) => {
+        ctx.abortSignal.throwIfAborted();
+        if (
+          gate &&
+          requireApproval &&
+          !("approval" in ctx && ctx.approval !== undefined)
+        ) {
+          throw new Error("missing exact consent");
+        }
+        effect();
+        return "ok";
+      },
+    });
+    const modelInstance = model();
+    const runtime = createToolLoopHarness({
+      // oxlint-disable-next-line eslint/require-await -- The harness requires an asynchronous model resolver even for this in-memory fixture.
+      resolveModel: async () => modelInstance,
+      tools: new Map([
+        [
+          "mcp",
+          {
+            name: "mcp",
+            description: "test",
+            inputSchema: jsonSchema({ type: "object" }),
+            approval: policy,
+            execute,
+          },
+        ],
+      ]),
+    });
+    await contextStorage.run(
+      createApprovalContext(),
+      async () => await runtime(session())
+    );
+    expect(policy).toHaveBeenCalled();
+    expect(effect).toHaveBeenCalledTimes(gate ? 0 : 1);
+  }
+);
