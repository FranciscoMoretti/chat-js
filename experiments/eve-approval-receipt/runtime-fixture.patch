+import {
+  appendFileSync,
+  existsSync,
+  readFileSync,
+  writeFileSync,
+} from "node:fs";
+import { setTimeout } from "node:timers/promises";
+
+import { defineDynamic, defineTool } from "eve/tools";
+import { z } from "zod";
+
+// Disposable files are the fixture's policy source and remote-effect spy.
+export default defineDynamic({
+  events: {
+    "step.started": () => {
+      const connector = readFileSync("connector.txt", "utf8");
+      const suffix = readFileSync("suffix.txt", "utf8");
+      return {
+        conditional: defineTool({
+          description: "Fixture MCP effect",
+          inputSchema: z.object({
+            label: z
+              .string()
+              .transform((value) => value.toUpperCase() + suffix),
+            amount: z.coerce.number(),
+            mode: z.string().default("safe"),
+          }),
+          approval: {
+            request(ctx) {
+              const policy = readFileSync("policy.txt", "utf8");
+              appendFileSync(
+                "requests.jsonl",
+                JSON.stringify({
+                  connector,
+                  input: ctx.toolInput,
+                  pid: process.pid,
+                }) + "\n"
+              );
+              if (policy === "flip") {
+                writeFileSync("policy.txt", "required");
+                return "not-applicable";
+              }
+              return policy === "required" ? "user-approval" : "not-applicable";
+            },
+            async response({ response }) {
+              appendFileSync(
+                "responses.jsonl",
+                JSON.stringify({
+                  pid: process.pid,
+                  decision: response.decision,
+                }) + "\n"
+              );
+              while (existsSync("pause-response")) await setTimeout(50);
+              return response.principal.principalId === "owner"
+                ? { status: "allowed" }
+                : { status: "rejected", reason: "owner only" };
+            },
+          },
+          async execute(input, ctx) {
+            const receipt = ("approval" in ctx ? ctx.approval : undefined) as
+              | {
+                  requestId: string;
+                  responder: { principalId: string; authenticator: string };
+                }
+              | undefined;
+            const evidence = {
+              connector,
+              input,
+              receipt,
+              caller: ctx.session.auth.current,
+              pid: process.pid,
+              callId: ctx.callId,
+            };
+            appendFileSync("entries.jsonl", JSON.stringify(evidence) + "\n");
+            while (existsSync("pause-before-effect")) await setTimeout(50);
+            ctx.abortSignal.throwIfAborted();
+            if (
+              readFileSync("policy.txt", "utf8") === "required" &&
+              (receipt?.responder.principalId !== "owner" ||
+                receipt.responder.authenticator !== "retirement-fixture")
+            )
+              return { blocked: "missing exact consent", ...evidence };
+            appendFileSync("effects.jsonl", JSON.stringify(evidence) + "\n");
+            return { effect: true, ...evidence };
+          },
+        }),
+      };
+    },
+  },
+});
diff --git a/runtime-fixture/agent/tools/static-gate.ts b/runtime-fixture/agent/tools/static-gate.ts
new file mode 100644
