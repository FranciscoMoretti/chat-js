+++ b/runtime-fixture/agent/tools/static-gate.ts
@@ -0,0 +1,36 @@
+import { readFileSync, writeFileSync, appendFileSync } from "node:fs";
+
+import { defineTool } from "eve/tools";
+import { z } from "zod";
+export default defineTool({
+  description:
+    "Static counterpart of conditional MCP gate for invokeTool coverage",
+  inputSchema: z.object({ label: z.string() }),
+  approval: {
+    request() {
+      const policy = readFileSync("policy.txt", "utf8");
+      if (policy === "flip") {
+        writeFileSync("policy.txt", "required");
+        return "not-applicable";
+      }
+      return policy === "required" ? "user-approval" : "not-applicable";
+    },
+  },
+  execute(input, ctx) {
+    ctx.abortSignal.throwIfAborted();
+    const receipt = ("approval" in ctx ? ctx.approval : undefined) as
+      | {
+          requestId: string;
+          responder: { principalId: string; authenticator: string };
+        }
+      | undefined;
+    if (
+      readFileSync("policy.txt", "utf8") === "required" &&
+      (receipt?.responder.principalId !== "owner" ||
+        receipt.responder.authenticator !== "retirement-fixture")
+    )
+      return { blocked: true, caller: ctx.session.auth.current };
+    appendFileSync("invoke-effects.jsonl", JSON.stringify(input) + "\n");
+    return { effect: true };
+  },
+});
