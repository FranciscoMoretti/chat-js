+++ b/runtime-old-run.ts
@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { writeFile, unlink, symlink } from "node:fs/promises";
+import path from "node:path";
+
+import { z } from "zod";
+import {
+  entrySchema,
+  exitAfterCleanup,
+  last,
+  loadClient,
+  loadHarness,
+  readRows,
+  receiptOf,
+} from "./runtime-contracts.ts";
+
+const [harness, productionModules, targetModules, handoff] = z
+  .tuple([
+    z.string().min(1),
+    z.string().min(1),
+    z.string().min(1),
+    z.string().min(1),
+  ])
+  .parse(process.argv.slice(2));
+const { preparePostgresFixture, createPersistentRuntime } =
+  await loadHarness(harness);
+const prepared = await preparePostgresFixture({
+  source: path.join(import.meta.dir, "runtime-fixture"),
+  nodeModules: productionModules,
+  handoff,
+  lane: "lane_b",
+});
+const runtime = await createPersistentRuntime(
+  prepared.source,
+  {
+    nodeModules: prepared.nodeModules,
+    distribution: "production-fork",
+    provenance:
+      "Old seed @chat-js/eve 0.61.0-chatjs.0 / 3a7acfe6; same PG data switched to experimental .71.3",
+  },
+  { world: "postgres", inlineOwnershipLeaseSeconds: 1 }
+);
+console.log("Old-run evidence:", runtime.directory);
+const put = async (name: string, value: string) => {
+  await writeFile(path.join(runtime.directory, name), value);
+};
+const rows = async () =>
+  await readRows(runtime.directory, "effects.jsonl", entrySchema);
+const OldClient = await loadClient(productionModules);
+const NewClient = await loadClient(targetModules);
+let stage = "seed-start";
+const watchdog = setTimeout(() => {
+  void exitAfterCleanup(async () => {
+    await runtime.crash();
+  });
+}, 180_000);
+try {
+  // oxlint-disable eslint/no-await-in-loop -- Seed the independent fixture marker files before starting the runtime.
+  for (const [name, value] of Object.entries({
+    "owner.txt": "owner",
+    "enabled.txt": "true",
+    "connector.txt": "original",
+    "suffix.txt": ":original",
+    "policy.txt": "open",
+  })) {
+    await put(name, value);
+  }
+  // oxlint-enable eslint/no-await-in-loop
+  await runtime.start();
+  const oldClient = new OldClient({ host: runtime.url });
+  const historical = await oldClient.sessions.create({
+    message: "history",
+    signal: AbortSignal.timeout(45_000),
+  });
+  await historical.response.result();
+  const snapshot = await historical.session.snapshot({
+    signal: AbortSignal.timeout(15_000),
+  });
+  assert.ok(snapshot.events.length > 0);
+  const historicalEffects = await rows();
+  assert.equal(
+    historicalEffects.filter(
+      (row) => row.sessionId === historical.session.state.sessionId
+    ).length,
+    1
+  );
+  stage = "seed-pending";
+  await put("policy.txt", "required");
+  const pending = await oldClient.sessions.create({
+    message: "hello",
+    signal: AbortSignal.timeout(45_000),
+  });
+  const waiting = await pending.response.result();
+  assert.equal(waiting.inputRequests.length, 1);
+  const pendingState = pending.session.state;
+  await put(
+    "old-seed.json",
+    JSON.stringify(
+      {
+        historical: historical.session.state,
+        snapshot,
+        pending: pendingState,
+        waiting,
+      },
+      null,
+      2
+    )
+  );
+  await runtime.crash();
+  stage = "switch";
+  await unlink(path.join(prepared.nodeModules, "eve"));
+  await symlink(
+    path.join(targetModules, "eve"),
+    path.join(prepared.nodeModules, "eve")
+  );
+  await put(
+    "package-switch.json",
+    JSON.stringify({
+      from: "@chat-js/eve@0.61.0-chatjs.0 / 3a7acfe6",
+      to: "eve@0.71.3 / fab8ba1424eddfdedd6a177cac21710258da0e81 + receipt.patch",
+      targetModules,
+      retainedDatabase: "lane_b",
+      retainedCompiledDirectory: path.join(runtime.directory, ".eve"),
+    })
+  );
+  await runtime.start();
+  const client = new NewClient({ host: runtime.url });
+  stage = "read-history";
+  const restoredHistory = await client.sessions
+    .attach(historical.session.state.sessionId)
+    .snapshot({ signal: AbortSignal.timeout(15_000) });
+  assert.deepEqual(restoredHistory.events, snapshot.events);
+  await put("history-decoded.json", JSON.stringify(restoredHistory, null, 2));
+  stage = "resume-pending";
+  const session = client.sessions.attach(pendingState.sessionId, {
+    streamIndex: pendingState.streamIndex,
+  });
+  const response = await session.respond(
+    waiting.inputRequests.map((request) => ({
+      requestId: request.requestId,
+      optionId: "approve",
+    })),
+    { signal: AbortSignal.timeout(45_000) }
+  );
+  await response.result();
+  const allEffects = await rows();
+  const effects = allEffects.filter(
+    (row) =>
+      row.sessionId === historical.session.state.sessionId ||
+      row.sessionId === pendingState.sessionId
+  );
+  assert.equal(effects.length, 2);
+  assert.equal(
+    receiptOf(last(effects)).requestId,
+    last(waiting.inputRequests).requestId
+  );
+  assert.equal(last(effects).connector, "original");
+  assert.deepEqual(last(effects).input, {
+    label: "HELLO:original",
+    amount: 2,
+    mode: "safe",
+  });
+  await put(
+    "old-run-results.json",
+    JSON.stringify(
+      { status: "passed", historyEvents: snapshot.events.length, effects },
+      null,
+      2
+    )
+  );
+  console.log("Historical decode and old pending approval passed");
+} catch (error) {
+  await put(
+    "old-run-results.json",
+    JSON.stringify(
+      {
+        status: "failed",
+        stage,
+        error: String(error),
+        stack: error instanceof Error ? error.stack : String(error),
+      },
+      null,
+      2
+    )
+  );
+  throw error;
+} finally {
+  await runtime.crash();
+  clearTimeout(watchdog);
+}
