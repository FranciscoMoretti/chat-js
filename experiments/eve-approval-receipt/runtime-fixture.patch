--- /dev/null
+++ b/runtime-scenarios.ts
@@ -0,0 +1,578 @@
+import type { MessageResponse } from "eve/client";
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import {
+  cp,
+  mkdtemp,
+  readFile,
+  rm,
+  symlink,
+  writeFile,
+} from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+
+import { once } from "node:events";
+import { setTimeout as delay } from "node:timers/promises";
+import type { ChildProcessByStdio } from "node:child_process";
+import type { Readable } from "node:stream";
+import { z } from "zod";
+import {
+  consumeInterrupted,
+  exitAfterCleanup,
+  isMissingFile,
+  last,
+  loadClient,
+  readRows,
+  receiptOf,
+  schemas,
+} from "./runtime-contracts.ts";
+import type { Entry, ProofRuntime } from "./runtime-contracts.ts";
+
+const settle = async (response: Promise<MessageResponse>) => {
+  const ready = await response;
+  return await ready.result();
+};
+
+const until = async (
+  check: () => boolean | Promise<boolean>,
+  label: string,
+  timeout = 60_000
+) => {
+  const start = Date.now();
+  // oxlint-disable eslint/no-await-in-loop -- Poll evidence serially; overlapping polls can observe a later barrier before an earlier one.
+  while (Date.now() - start < timeout) {
+    const value = await check();
+    if (value) {
+      return value;
+    }
+    await delay(100);
+  }
+  // oxlint-enable eslint/no-await-in-loop
+  throw new Error(`Timed out: ${label}`);
+};
+
+export const runProof = async ({
+  dependencies,
+  mode,
+  runtime: externalRuntime,
+  restartOnly = false,
+}: {
+  dependencies: string;
+  mode: "stock" | "patched";
+  runtime?: ProofRuntime;
+  restartOnly?: boolean;
+}) => {
+  const Client = await loadClient(path.join(dependencies, "node_modules"));
+  const app =
+    externalRuntime?.directory ??
+    (await mkdtemp(path.join(tmpdir(), "lane-b-workflow-")));
+  if (!externalRuntime) {
+    await cp(new URL("runtime-fixture", import.meta.url), app, {
+      recursive: true,
+    });
+    await symlink(
+      path.join(dependencies, "node_modules"),
+      path.join(app, "node_modules")
+    );
+    await writeFile(
+      path.join(app, "package.json"),
+      JSON.stringify({
+        type: "module",
+        dependencies: { eve: "0.71.3", ai: "7.0.106" },
+      })
+    );
+  }
+  const file = (name: string) => path.join(app, name);
+  const put = async (name: string, value: string) => {
+    await writeFile(file(name), value);
+  };
+  const rows = async <T extends z.core.$ZodType>(name: string, schema: T) =>
+    await readRows(app, name, schema);
+  const count = async (name: keyof typeof schemas) => {
+    const values = await readRows(app, name, schemas[name]);
+    return values.length;
+  };
+  const latest = async <T extends z.core.$ZodType>(name: string, schema: T) => {
+    const values = await readRows(app, name, schema);
+    return last(values);
+  };
+  const latestPid = async (name: "requests.jsonl" | "responses.jsonl") => {
+    const values = await readRows(app, name, schemas[name]);
+    return z.object({ pid: z.number().int().positive() }).parse(last(values))
+      .pid;
+  };
+  let worker: ChildProcessByStdio<null, Readable, Readable> | undefined;
+  let url = "";
+  let logs = "";
+  const start = async (resume = false) => {
+    if (externalRuntime) {
+      await externalRuntime.start();
+      ({ url } = externalRuntime);
+      return;
+    }
+    logs = "";
+    worker = spawn(
+      process.execPath,
+      [
+        path.join(dependencies, "node_modules/eve/bin/eve.js"),
+        "dev",
+        "--no-ui",
+        "--host",
+        "127.0.0.1",
+        "--port",
+        "0",
+        "--no-default-extensions",
+        ...(resume ? ["--resume"] : []),
+      ],
+      {
+        cwd: app,
+        env: {
+          PATH: `${path.dirname(process.execPath)}:/opt/homebrew/bin:/usr/bin:/bin`,
+          HOME: app,
+          NODE_ENV: "development",
+          EVE_MOCK_AUTHORED_MODELS: "0",
+          WORKFLOW_INLINE_OWNERSHIP_LEASE_SECONDS: "1",
+          DOCKER_HOST: `unix://${file("no-docker.sock")}`,
+        },
+        stdio: ["ignore", "pipe", "pipe"],
+      }
+    );
+    worker.stdout.setEncoding("utf-8");
+    worker.stdout.on("data", (chunk: string) => {
+      logs += chunk;
+    });
+    worker.stderr.setEncoding("utf-8");
+    worker.stderr.on("data", (chunk: string) => {
+      logs += chunk;
+    });
+    const addressPattern = /http:\/\/127\.0\.0\.1:\d+/u;
+    await until(() => addressPattern.test(logs), "startup");
+    url = z.url().parse(addressPattern.exec(logs)?.[0]);
+  };
+  const stop = async (crash = false, serverPid?: number) => {
+    if (externalRuntime) {
+      await externalRuntime.crash(crash ? serverPid : undefined);
+      return;
+    }
+    if (!worker || worker.exitCode !== null || worker.signalCode !== null) {
+      return;
+    }
+    const stopped = once(worker, "exit");
+    worker.kill(crash ? "SIGKILL" : "SIGTERM");
+    const stopping = worker;
+    const timer = setTimeout(() => {
+      stopping.kill("SIGKILL");
+    }, 10_000);
+    await stopped;
+    clearTimeout(timer);
+    if (crash) {
+      await until(async () => {
+        try {
+          await readFile(file(".eve/dev-server-state.v1.json"));
+          return false;
+        } catch (error) {
+          return isMissingFile(error);
+        }
+      }, "dev ownership release");
+    }
+  };
+  const create = async () =>
+    await new Client({ host: url }).sessions.create({ message: "hello" });
+  const required = async () => {
+    await put("policy.txt", "required");
+    const made = await create();
+    const waiting = await made.response.result();
+    assert.equal(waiting.inputRequests.length, 1);
+    return { made, waiting };
+  };
+  const checkEntry = (entry: Entry) => {
+    assert.equal(entry.caller.principalId, "owner");
+    assert.equal(entry.connector, "original");
+    assert.deepEqual(entry.input, {
+      label: "HELLO:original",
+      amount: 2,
+      mode: "safe",
+    });
+    if (mode === "patched") {
+      assert.equal(receiptOf(entry).responder.principalId, "owner");
+    } else {
+      assert.equal(entry.receipt, undefined);
+    }
+  };
+  const watchdog = setTimeout(
+    () => {
+      worker?.kill("SIGKILL");
+      console.error("Runtime proof timeout:", app);
+      if (externalRuntime) {
+        void exitAfterCleanup(async () => {
+          await externalRuntime.crash();
+        });
+      } else {
+        process.exit(1);
+      }
+    },
+    externalRuntime ? 300_000 : 180_000
+  );
+  const results: string[] = [];
+  let entry: Entry;
+  const runPolicyCases = async () => {
+    const invoke = async (name: string) => {
+      const response = await fetch(`${url}/proof/invoke`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ name }),
+      });
+      assert.equal(response.status, 200);
+      const body: unknown = await response.json();
+      return z
+        .object({
+          status: z.string(),
+          output: z
+            .object({
+              blocked: z.boolean(),
+              caller: z.object({ principalId: z.string() }),
+            })
+            .optional(),
+        })
+        .parse(body);
+    };
+    await put("policy.txt", "required");
+    const observed0 = await invoke("static-gate");
+    assert.equal(observed0.status, "approval-required");
+    await put("policy.txt", "flip");
+    const outOfTurn = await invoke("static-gate");
+    assert.equal(outOfTurn.status, "completed");
+    assert.ok(outOfTurn.output);
+    assert.equal(outOfTurn.output.blocked, true);
+    assert.equal(outOfTurn.output.caller.principalId, "owner");
+    assert.equal(await count("invoke-effects.jsonl"), 0);
+    const observed1 = await invoke("conditional");
+    assert.equal(observed1.status, "failed");
+    results.push(
+      "invokeTool: required approval blocks, policy flip has no receipt, dynamic name is unavailable"
+    );
+    await put("policy.txt", "flip");
+    const flipped = await create();
+    await flipped.response.result();
+    assert.equal(await count("effects.jsonl"), 0);
+    const flippedEntry = await latest(
+      "entries.jsonl",
+      schemas["entries.jsonl"]
+    );
+    assert.equal(flippedEntry.receipt, undefined);
+    assert.equal(flippedEntry.caller.principalId, "owner");
+    results.push("policy flip: owner caller without consent blocked");
+    const { made, waiting } = await required();
+    const requestPid = await latestPid("requests.jsonl");
+    await stop(true, requestPid);
+    await start(true);
+    const restored = new Client({ host: url }).sessions.attach(
+      made.session.state.sessionId,
+      {
+        streamIndex: made.session.state.streamIndex,
+      }
+    );
+    await settle(
+      restored.respond(
+        waiting.inputRequests.map((request) => ({
+          requestId: request.requestId,
+          optionId: "approve",
+        }))
+      )
+    );
+    entry = await latest("entries.jsonl", schemas["entries.jsonl"]);
+    assert.notEqual(entry.pid, requestPid);
+    checkEntry(entry);
+    assert.equal(await count("effects.jsonl"), mode === "patched" ? 1 : 0);
+    results.push(
+      "actual Workflow restart before response: original dynamic closure and transformed input retained"
+    );
+
+    const observed2 = await rows("requests.jsonl", schemas["requests.jsonl"]);
+    const originalRequest = observed2.find(
+      (row) => row.sessionId === entry.sessionId && row.callId === entry.callId
+    );
+    assert.ok(originalRequest);
+    if (mode === "patched") {
+      assert.equal(entry.messages, originalRequest.messages);
+    } else {
+      assert.notEqual(entry.messages, originalRequest.messages);
+    }
+    const observed3 = await rows("discovery.jsonl", schemas["discovery.jsonl"]);
+    assert.ok(
+      observed3.some(
+        (row) =>
+          row.sessionId === entry.sessionId &&
+          row.messages !== originalRequest.messages
+      )
+    );
+    results.push(
+      "captured history change: original approved closure retained only in patched mode"
+    );
+    const changed = await required();
+    await stop(true, await latestPid("requests.jsonl"));
+    await put("connector.txt", "replacement");
+    await put("suffix.txt", ":replacement");
+    await start(true);
+    const changedSession = new Client({ host: url }).sessions.attach(
+      changed.made.session.state.sessionId,
+      { streamIndex: changed.made.session.state.streamIndex }
+    );
+    await settle(
+      changedSession.respond(
+        changed.waiting.inputRequests.map((request) => ({
+          requestId: request.requestId,
+          optionId: "approve",
+        }))
+      )
+    );
+    const changedEntry = await latest(
+      "entries.jsonl",
+      schemas["entries.jsonl"]
+    );
+    if (mode === "patched") {
+      checkEntry(changedEntry);
+    } else {
+      assert.equal(changedEntry.connector, "replacement");
+      assert.equal(changedEntry.receipt, undefined);
+    }
+    assert.equal(await count("effects.jsonl"), mode === "patched" ? 2 : 0);
+    results.push(
+      "step discovery replacement cannot inherit consent: original bound connector executes only in patched mode"
+    );
+    const observed4 = await rows(
+      "projections.jsonl",
+      schemas["projections.jsonl"]
+    );
+    const projection = observed4.find(
+      (row) =>
+        row.output.callId === changedEntry.callId &&
+        row.output.sessionId === changedEntry.sessionId
+    );
+    assert.ok(projection);
+    assert.equal(
+      projection.connector,
+      mode === "patched" ? "original" : "replacement"
+    );
+    if (mode === "patched") {
+      assert.equal(projection.messages, changedEntry.messages);
+    }
+    const nextWaiting = await settle(changedSession.send("next"));
+    assert.equal(nextWaiting.inputRequests.length, 1);
+    assert.equal(await count("effects.jsonl"), mode === "patched" ? 2 : 0);
+    await settle(
+      changedSession.respond(
+        nextWaiting.inputRequests.map((request) => ({
+          requestId: request.requestId,
+          optionId: "approve",
+        }))
+      )
+    );
+    const nextEntry = await latest("entries.jsonl", schemas["entries.jsonl"]);
+    assert.equal(nextEntry.connector, "replacement");
+    assert.deepEqual(nextEntry.input, {
+      label: "NEXT:replacement",
+      amount: 2,
+      mode: "safe",
+    });
+    assert.notEqual(nextEntry.callId, changedEntry.callId);
+    if (mode === "patched") {
+      assert.equal(
+        receiptOf(nextEntry).requestId,
+        last(nextWaiting.inputRequests).requestId
+      );
+    }
+    assert.equal(await count("effects.jsonl"), mode === "patched" ? 3 : 0);
+    results.push(
+      "new call uses refreshed connector/schema and requires separate consent; resumed output keeps original projection"
+    );
+    // A new session starts with original values again. Crash after the runtime
+    // supplied the settled receipt but before the fixture remote effect begins.
+    await put("connector.txt", "original");
+    await put("suffix.txt", ":original");
+    // oxlint-disable eslint/no-await-in-loop -- Each revocation scenario must settle and restore policy before the next scenario starts.
+    for (const [name, revoked, restoredValue] of [
+      ["owner.txt", "other", "owner"],
+      ["enabled.txt", "false", "true"],
+    ]) {
+      const revokedCall = await required();
+      await put(name, revoked);
+      await settle(
+        revokedCall.made.session.respond(
+          revokedCall.waiting.inputRequests.map((request) => ({
+            requestId: request.requestId,
+            optionId: "approve",
+          }))
+        )
+      );
+      assert.equal(await count("effects.jsonl"), mode === "patched" ? 3 : 0);
+      await put(name, restoredValue);
+    }
+    // oxlint-enable eslint/no-await-in-loop
+    results.push(
+      "live owner and enabled checks block effects despite valid prior consent"
+    );
+    const cancelled = await required();
+    await settle(
+      cancelled.made.session.respond(
+        cancelled.waiting.inputRequests.map((request) => ({
+          requestId: request.requestId,
+          optionId: "cancel",
+        }))
+      )
+    );
+    assert.equal(await count("effects.jsonl"), mode === "patched" ? 3 : 0);
+    results.push("owner cancellation: zero new effects");
+  };
+  try {
+    await put("owner.txt", "owner");
+    await put("enabled.txt", "true");
+    await put("connector.txt", "original");
+    await put("suffix.txt", ":original");
+    await put("policy.txt", "flip");
+    await start();
+
+    if (!restartOnly) {
+      await runPolicyCases();
+    }
+    const priorEffects = await count("effects.jsonl");
+    const beforeCandidate = await required();
+    const responseCount = await count("responses.jsonl");
+    const entryCount = await count("entries.jsonl");
+    await put("pause-response", "1");
+    const candidateAbort = new AbortController();
+    const candidateResponse = await beforeCandidate.made.session.respond(
+      beforeCandidate.waiting.inputRequests.map((request) => ({
+        requestId: request.requestId,
+        optionId: "approve",
+      })),
+      { signal: candidateAbort.signal }
+    );
+    void consumeInterrupted(candidateResponse.result());
+    await until(
+      async () => (await count("responses.jsonl")) > responseCount,
+      "candidate authorizer entry"
+    );
+    const candidatePid = await latestPid("responses.jsonl");
+    assert.equal(await count("entries.jsonl"), entryCount);
+    candidateAbort.abort();
+    await stop(true, candidatePid);
+    await rm(file("pause-response"));
+    await start(true);
+    await until(
+      async () => (await count("entries.jsonl")) > entryCount,
+      "candidate settlement after Workflow restart",
+      externalRuntime ? 15_000 : 60_000
+    );
+    const candidateEntry = await latest(
+      "entries.jsonl",
+      schemas["entries.jsonl"]
+    );
+    assert.notEqual(candidateEntry.pid, candidatePid);
+    checkEntry(candidateEntry);
+    if (mode === "patched") {
+      assert.equal(
+        receiptOf(candidateEntry).requestId,
+        last(beforeCandidate.waiting.inputRequests).requestId
+      );
+    }
+    await until(
+      async () =>
+        mode === "stock" || (await count("effects.jsonl")) === priorEffects + 1,
+      "candidate effect"
+    );
+    results.push(
+      "actual Workflow restart after candidate ingestion, before settlement: authorization resumes without resending"
+    );
+    const second = await required();
+    const before = await count("entries.jsonl");
+    await put("pause-before-effect", "1");
+    const streamAbort = new AbortController();
+    const response = await second.made.session.respond(
+      second.waiting.inputRequests.map((request) => ({
+        requestId: request.requestId,
+        optionId: "approve",
+      })),
+      { signal: streamAbort.signal }
+    );
+    void consumeInterrupted(response.result());
+    await until(
+      async () => (await count("entries.jsonl")) > before,
+      "executor after settlement"
+    );
+    entry = await latest("entries.jsonl", schemas["entries.jsonl"]);
+    checkEntry(entry);
+    const enteredPid = entry.pid;
+    const settledReceipt = entry.receipt;
+    if (mode === "patched") {
+      assert.equal(
+        receiptOf(entry).requestId,
+        last(second.waiting.inputRequests).requestId
+      );
+    }
+    streamAbort.abort();
+    await stop(true, enteredPid);
+    await rm(file("pause-before-effect"));
+    await start(true);
+    await until(
+      async () => {
+        const all = await rows("entries.jsonl", schemas["entries.jsonl"]);
+        return all.length > before + 1 && last(all).pid !== enteredPid;
+      },
+      "Workflow replay of interrupted executor",
+      externalRuntime ? 15_000 : 90_000
+    );
+    entry = await latest("entries.jsonl", schemas["entries.jsonl"]);
+    checkEntry(entry);
+    assert.deepEqual(entry.receipt, settledReceipt);
+    await until(
+      async () =>
+        mode === "stock" || (await count("effects.jsonl")) === priorEffects + 2,
+      "effect after replay"
+    );
+    assert.equal(
+      await count("effects.jsonl"),
+      mode === "patched" ? priorEffects + 2 : 0
+    );
+    results.push(
+      mode === "patched"
+        ? "actual Workflow restart after settlement: interrupted callback replay reconstructs exact receipt"
+        : "actual Workflow restart after settlement: caller remains owner, missing receipt still blocks effect"
+    );
+    await writeFile(
+      file("proof-results.json"),
+      JSON.stringify(
+        {
+          mode,
+          results,
+          entries: await rows("entries.jsonl", schemas["entries.jsonl"]),
+          effects: await rows("effects.jsonl", schemas["effects.jsonl"]),
+        },
+        null,
+        2
+      )
+    );
+    console.log(JSON.stringify({ mode, results, evidence: app }, null, 2));
+  } catch (error) {
+    await writeFile(file("failure.log"), logs);
+    await writeFile(
+      file("failure.json"),
+      JSON.stringify(
+        {
+          error: String(error),
+          stack: error instanceof Error ? error.stack : String(error),
+          results,
+        },
+        null,
+        2
+      )
+    );
+    console.error(error);
+    console.error("Retained failure evidence:", app);
+    throw error;
+  } finally {
+    await stop();
+    clearTimeout(watchdog);
+  }
+};
