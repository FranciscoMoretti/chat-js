@@ -0,0 +1,56 @@
+import { describe, expect, it } from "bun:test";
+
+import {
+  consumeInterrupted,
+  entrySchema,
+  receiptOf,
+} from "./runtime-contracts.ts";
+
+const evidence = {
+  connector: "original",
+  messages: "[]",
+  sessionId: "session",
+  callId: "call",
+  pid: 1,
+  input: { label: "HELLO:original", amount: 2, mode: "safe" },
+  caller: { principalId: "owner" },
+  receipt: {
+    requestId: "approval",
+    responder: {
+      principalId: "owner",
+      authenticator: "fixture",
+      issuer: "trusted",
+      principalType: "user",
+    },
+  },
+};
+
+describe("runtime proof evidence boundaries", () => {
+  it("retains issuer and principal type so replay comparison cannot hide identity changes", () => {
+    const entry = entrySchema.parse(evidence);
+    const changed = entrySchema.parse({
+      ...evidence,
+      receipt: {
+        ...evidence.receipt,
+        responder: { ...evidence.receipt.responder, issuer: "foreign" },
+      },
+    });
+    expect(receiptOf(entry)).toEqual(evidence.receipt);
+    expect(receiptOf(entry)).not.toEqual(receiptOf(changed));
+  });
+  it("rejects malformed execution evidence instead of accepting a weak assertion", () => {
+    expect(() =>
+      entrySchema.parse({
+        ...evidence,
+        input: { ...evidence.input, amount: "2" },
+      })
+    ).toThrow();
+    expect(() => entrySchema.parse({ ...evidence, pid: undefined })).toThrow();
+  });
+  it("handles an interrupted stream without waiting for completion before the crash barrier", async () => {
+    const { promise, reject } = Promise.withResolvers<unknown>();
+    const consumed = consumeInterrupted(promise);
+    reject(new Error("fixture disconnected"));
+    await consumed;
+  });
+});
