+import {
+  appendFileSync,
+  existsSync,
+  readFileSync,
+  writeFileSync,
+} from "node:fs";
+import { setTimeout } from "node:timers/promises";
+
+import { defineDynamic, defineTool } from "eve/tools";
+import { z } from "zod";
+
+// Disposable files are the fixture's policy source and remote-effect spy.
+export default defineDynamic({
+  events: {
+    "step.started": (_event, context) => {
+      const messages = JSON.stringify(context.messages);
+      appendFileSync(
+        "discovery.jsonl",
+        `${JSON.stringify({ messages, sessionId: context.session.id })}\n`
+      );
+      const connector = readFileSync("connector.txt", "utf-8");
+      const suffix = readFileSync("suffix.txt", "utf-8");
+      return {
+        conditional: defineTool({
+          description: "Fixture MCP effect",
+          inputSchema: z.object({
+            label: z
+              .string()
+              .transform((value) => value.toUpperCase() + suffix),
+            amount: z.coerce.number(),
+            mode: z.string().default("safe"),
+          }),
+          toModelOutput(output) {
+            appendFileSync(
+              "projections.jsonl",
+              `${JSON.stringify({ connector, messages, output })}\n`
+            );
+            return { type: "text", value: JSON.stringify(output) };
+          },
+          approval: {
+            request(ctx) {
+              const policy = readFileSync("policy.txt", "utf-8");
+              appendFileSync(
+                "requests.jsonl",
+                `${JSON.stringify({
+                  connector,
+                  messages,
+                  sessionId: ctx.session.id,
+                  callId: ctx.callId,
+                  input: ctx.toolInput,
+                  pid: process.pid,
+                })}\n`
+              );
+              if (policy === "flip") {
+                writeFileSync("policy.txt", "required");
+                return "not-applicable";
+              }
+              return policy === "required" ? "user-approval" : "not-applicable";
+            },
+            async response({ response }) {
+              appendFileSync(
+                "responses.jsonl",
+                `${JSON.stringify({
+                  pid: process.pid,
+                  decision: response.decision,
+                })}\n`
+              );
+              // oxlint-disable eslint/no-await-in-loop -- This process-local barrier must remain closed until the controller releases it.
+              while (existsSync("pause-response")) {
+                await setTimeout(50);
+              }
+              // oxlint-enable eslint/no-await-in-loop
+              return response.principal.principalId === "owner"
+                ? { status: "allowed" }
+                : { status: "rejected", reason: "owner only" };
+            },
+          },
+          async execute(input, ctx) {
+            const receipt = z
+              .looseObject({
+                requestId: z.string(),
+                responder: z.looseObject({
+                  principalId: z.string(),
+                  authenticator: z.string(),
+                }),
+              })
+              .optional()
+              .parse("approval" in ctx ? ctx.approval : undefined);
+            const evidence = {
+              connector,
+              messages,
+              sessionId: ctx.session.id,
+              input,
+              receipt,
+              caller: ctx.session.auth.current,
+              pid: process.pid,
+              callId: ctx.callId,
+            };
+            appendFileSync("entries.jsonl", `${JSON.stringify(evidence)}\n`);
+            // oxlint-disable eslint/no-await-in-loop -- Preserve the executor-entry barrier before any effect.
+            while (existsSync("pause-before-effect")) {
+              await setTimeout(50);
+            }
+            // oxlint-enable eslint/no-await-in-loop
+            ctx.abortSignal.throwIfAborted();
+            if (
+              readFileSync("owner.txt", "utf-8") !==
+                ctx.session.auth.initiator?.principalId ||
+              readFileSync("enabled.txt", "utf-8") !== "true"
+            ) {
+              return { blocked: "current connector unavailable", ...evidence };
+            }
+            if (
+              readFileSync("policy.txt", "utf-8") === "required" &&
+              (receipt?.responder.principalId !== "owner" ||
+                receipt.responder.authenticator !== "retirement-fixture")
+            ) {
+              return { blocked: "missing exact consent", ...evidence };
+            }
+            appendFileSync("effects.jsonl", `${JSON.stringify(evidence)}\n`);
+            return { effect: true, ...evidence };
+          },
+        }),
+      };
+    },
+  },
+});
