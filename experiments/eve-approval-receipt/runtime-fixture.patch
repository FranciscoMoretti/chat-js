+    z.string().min(1),
+    z.string().min(1),
+    z.literal("--restart-only").optional(),
+  ])
+  .parse(process.argv.slice(2));
+const { preparePostgresFixture, createPersistentRuntime } =
+  await loadHarness(harness);
+const prepared = await preparePostgresFixture({
+  source: path.join(import.meta.dir, "runtime-fixture"),
+  nodeModules: path.join(dependencies, "node_modules"),
