+++ b/runtime-contracts.ts
@@ -0,0 +1,186 @@
+import { readFile } from "node:fs/promises";
+import path from "node:path";
+import { pathToFileURL } from "node:url";
+
+import type { Client } from "eve/client";
+import { z } from "zod";
+
+export const receiptSchema = z.looseObject({
+  requestId: z.string(),
+  responder: z.looseObject({
+    principalId: z.string(),
+    authenticator: z.string(),
+  }),
+});
+export const entrySchema = z.looseObject({
+  connector: z.string(),
+  messages: z.string(),
+  sessionId: z.string(),
+  input: z.looseObject({
+    label: z.string(),
+    amount: z.number(),
+    mode: z.string(),
+  }),
+  receipt: receiptSchema.optional(),
+  caller: z.looseObject({ principalId: z.string() }),
+  pid: z.number().int().positive(),
+  callId: z.string(),
+});
+export type Entry = z.infer<typeof entrySchema>;
+export const schemas = {
+  "entries.jsonl": entrySchema,
+  "effects.jsonl": entrySchema,
+  "requests.jsonl": z.object({
+    connector: z.string(),
+    messages: z.string(),
+    sessionId: z.string(),
+    callId: z.string(),
+    input: z.unknown(),
+    pid: z.number().int().positive(),
+  }),
+  "responses.jsonl": z.object({
+    pid: z.number().int().positive(),
+    decision: z.string(),
+  }),
+  "discovery.jsonl": z.object({ messages: z.string(), sessionId: z.string() }),
+  "projections.jsonl": z.object({
+    connector: z.string(),
+    messages: z.string(),
+    output: entrySchema,
+  }),
+  "invoke-effects.jsonl": z.unknown(),
+};
+export const isMissingFile = (error: unknown) =>
+  error instanceof Error && "code" in error && error.code === "ENOENT";
+export const readRows = async <T extends z.core.$ZodType>(
+  directory: string,
+  name: string,
+  schema: T
+): Promise<z.output<T>[]> => {
+  try {
+    const content = await readFile(path.join(directory, name), "utf-8");
+    return content
+      .trim()
+      .split("\n")
+      .filter(Boolean)
+      .map((line) => {
+        const value: unknown = JSON.parse(line);
+        return z.parse(schema, value);
+      });
+  } catch (error) {
+    if (isMissingFile(error)) {
+      return [];
+    }
+    throw error;
+  }
+};
+export const last = <T>(values: readonly T[]): T => {
+  const value = values.at(-1);
+  if (value === undefined) {
+    throw new Error("Expected nonempty proof evidence");
+  }
+  return value;
+};
+export const receiptOf = (entry: Entry) => receiptSchema.parse(entry.receipt);
+
+// This trusted package boundary accepts only the pinned released SDKs used by
+// the proof. The constructor's static type comes from the pinned 0.71.3 client;
+// runtime identity and its callable shape are checked before constructing it.
+export const loadClient = async (nodeModules: string) => {
+  const raw: unknown = JSON.parse(
+    await readFile(path.join(nodeModules, "eve/package.json"), "utf-8")
+  );
+  z.union([
+    z.object({ name: z.literal("eve"), version: z.literal("0.71.3") }),
+    z.object({
+      name: z.literal("@chat-js/eve"),
+      version: z.literal("0.61.0-chatjs.0"),
+    }),
+  ]).parse(raw);
+  const loaded: unknown = await import(
+    pathToFileURL(path.join(nodeModules, "eve/dist/src/client/index.js")).href
+  );
+  const clientModule = z
+    .object({
+      Client: z.custom<typeof Client>(
+        (value: unknown) => typeof value === "function"
+      ),
+    })
+    .parse(loaded);
+  return clientModule.Client;
+};
+
+const runtimeSchema = z.object({
+  directory: z.string(),
+  url: z.url(),
+  start: z.function({ input: [], output: z.promise(z.void()) }),
+  crash: z.function({
+    input: z.tuple([z.number().int().positive().optional()]),
+    output: z.promise(z.void()),
+  }),
+});
+export type ProofRuntime = z.infer<typeof runtimeSchema>;
+const installationSchema = z.object({
+  nodeModules: z.string(),
+  provenance: z.string(),
+  distribution: z.literal("production-fork").optional(),
+});
+export const loadHarness = async (harness: string) => {
+  const preparation: unknown = await import(
+    pathToFileURL(path.join(harness, "postgres-fixture.ts")).href
+  );
+  const lifecycle: unknown = await import(
+    pathToFileURL(path.join(harness, "persistent-runtime.ts")).href
+  );
+  const { preparePostgresFixture } = z
+    .object({
+      preparePostgresFixture: z.function({
+        input: [
+          z.object({
+            source: z.string(),
+            nodeModules: z.string(),
+            handoff: z.string(),
+            lane: z.literal("lane_b"),
+          }),
+        ],
+        output: z.promise(
+          z.object({ source: z.string(), nodeModules: z.string() })
+        ),
+      }),
+    })
+    .parse(preparation);
+  const { createPersistentRuntime } = z
+    .object({
+      createPersistentRuntime: z.function({
+        input: [
+          z.string(),
+          installationSchema,
+          z.object({
+            world: z.literal("postgres"),
+            inlineOwnershipLeaseSeconds: z.literal(1),
+          }),
+        ],
+        output: z.promise(runtimeSchema),
+      }),
+    })
+    .parse(lifecycle);
+  return { preparePostgresFixture, createPersistentRuntime };
+};
+
+// Crash tests start consuming a response before the barrier; the expected
+// abort/disconnect rejection must be handled immediately without awaiting it.
+export const consumeInterrupted = async (result: Promise<unknown>) => {
+  try {
+    await result;
+  } catch {
+    // The scenario verifies durable replay separately.
+  }
+};
+export const exitAfterCleanup = async (cleanup: () => Promise<void>) => {
+  try {
+    await cleanup();
+  } catch (error) {
+    console.error(error);
+  }
+  process.exit(1);
+};
