@@ -0,0 +1,640 @@
+import { z } from "zod";
+import { isDeepStrictEqual } from "node:util";
+import { validateHarnessModelMessages } from "#harness/messages.js";
+import type { HarnessToolMap, HarnessSession } from "#harness/types.js";
+import { jsonSchema, modelMessageSchema } from "ai";
+import type { ModelMessage } from "ai";
+import { MockLanguageModelV4 } from "ai/test";
+import { expect, it, vi } from "vitest";
+import {
+  createApprovalContext,
+  usage,
+} from "#internal/testing/approval-resume.js";
+import { contextStorage } from "#context/container.js";
+import { createToolLoopHarness } from "#harness/tool-loop.js";
+import { createToolExecuteWithAuth } from "#execution/tool-auth.js";
+import { appendPendingInputBatch } from "#harness/input-requests.js";
+import { setHarnessEmissionState } from "#harness/emission.js";
+import {
+  AuthKey,
+  SessionKey,
+  StepDynamicToolMetadataKey,
+} from "#context/keys.js";
+import {
+  getApprovalAuditState,
+  settleDirectApprovalResponse,
+} from "#harness/approval-candidates.js";
+import type { ToolContext } from "#tools/definition.js";
+import {
+  getToolApprovalReceipt,
+  prepareToolApprovalReceipts,
+  approvedToolDefinition,
+  executeApprovedBinding,
+} from "#context/tool-approval-receipts.js";
+import { coordinateApprovalDelivery } from "#harness/approval-delivery-coordinator.js";
+import { readFileSync, writeFileSync } from "node:fs";
+
+vi.mock("#runtime/attributes/emit.js", () => ({
+  setEveAttributes: vi.fn(async () => {}),
+}));
+const fixtureAuth = (ctx: ReturnType<typeof createApprovalContext>) => {
+  const auth = ctx.require(AuthKey);
+  if (auth === null) {
+    throw new Error("Expected authenticated fixture owner");
+  }
+  return auth;
+};
+
+const call = {
+  type: "tool-call" as const,
+  toolCallId: "call-1",
+  toolName: "mcp",
+  input: JSON.stringify({ value: 1 }),
+};
+const session = (): HarnessSession => ({
+  sessionId: "generate-approval-resume-session",
+  continuationToken: "http:receipt",
+  agent: {
+    modelReference: { id: "receipt" },
+    system: "test",
+    tools: [
+      { name: "mcp", description: "test", inputSchema: { type: "object" } },
+    ],
+  },
+  history: [{ kind: "user", role: "user", content: "act" }],
+  compaction: { recentWindowSize: 10, threshold: 100_000 },
+});
+
+const request = {
+  requestId: "approval-1",
+  kind: "tool-approval" as const,
+  display: "confirmation" as const,
+  allowFreeform: false,
+  prompt: "Approve",
+  options: [
+    { id: "approve", label: "Yes" },
+    { id: "cancel", label: "No" },
+  ],
+  action: {
+    kind: "tool-call" as const,
+    callId: "call-1",
+    toolName: "mcp",
+    input: { value: 1 },
+  },
+};
+const pendingSession = () =>
+  appendPendingInputBatch({
+    event: { sequence: 1, stepIndex: 1, turnId: "turn-1" },
+    session: setHarnessEmissionState(session(), {
+      sequence: 1,
+      stepIndex: 1,
+      turnId: "turn-1",
+      sessionStarted: true,
+    }),
+    requests: [request],
+    responseAuthRequiredRequestIds: ["approval-1"],
+    responseMessages: [
+      {
+        role: "assistant",
+        content: [
+          { ...call, input: { value: 1 } },
+          {
+            type: "tool-approval-request",
+            approvalId: "approval-1",
+            toolCallId: "call-1",
+          },
+        ],
+      },
+    ],
+  });
+const resumeFixture = () => {
+  const effect = vi.fn();
+  const receipts: ToolContext["approval"][] = [];
+  const execute = createToolExecuteWithAuth({
+    scope: "mcp",
+    execute: (_input, ctx) => {
+      receipts.push(ctx.approval);
+      ctx.abortSignal.throwIfAborted();
+      if (ctx.approval?.responder.principalId !== "user-1") {
+        throw new Error("missing owner consent");
+      }
+      effect();
+      return "ok";
+    },
+  });
+  const runtime = createToolLoopHarness({
+    // oxlint-disable-next-line eslint/require-await -- The harness requires an asynchronous model resolver even for this in-memory fixture.
+    resolveModel: async () =>
+      new MockLanguageModelV4({
+        provider: "eve-integration-mock",
+        modelId: "receipt",
+        doGenerate: {
+          content: [{ type: "text", text: "done" }],
+          finishReason: { raw: undefined, unified: "stop" },
+          usage,
+          warnings: [],
+        },
+      }),
+    tools: new Map([
+      [
+        "mcp",
+        {
+          name: "mcp",
+          description: "test",
+          inputSchema: jsonSchema({ type: "object" }),
+          approval: {
+            request: () => "user-approval",
+            response: ({ response }) =>
+              response.principal.principalId === "user-1" &&
+              response.principal.issuer === "test" &&
+              response.principal.authenticator === "test"
+                ? { status: "allowed" }
+                : { status: "rejected", reason: "owner only" },
+          },
+          execute,
+        },
+      ],
+    ]),
+  });
+  return { runtime, effect, receipts };
+};
+it.each([
+  ["user-1", "approve", 1],
+  ["user-1", "cancel", 0],
+  ["foreign", "approve", 0],
+  ["foreign", "cancel", 0],
+] as const)(
+  "authenticated %s %s => effects %s",
+  async (principalId, optionId, count) => {
+    const f = resumeFixture();
+    const ctx = createApprovalContext();
+    const auth = { ...fixtureAuth(ctx), principalId };
+    let result = await contextStorage.run(
+      ctx,
+      async () =>
+        await f.runtime(pendingSession(), {
+          attributedInputResponses: [
+            { auth, response: { requestId: "approval-1", optionId } },
+          ],
+        })
+    );
+    // oxlint-disable eslint/no-await-in-loop -- Each harness continuation consumes the previous result and cannot run concurrently.
+    for (let i = 0; i < 3 && typeof result.next === "function"; i += 1) {
+      const { next, session: currentSession } = result;
+      result = await contextStorage.run(
+        createApprovalContext(),
+        async () => await next(structuredClone(currentSession))
+      );
+    }
+    // oxlint-enable eslint/no-await-in-loop
+    expect(f.effect).toHaveBeenCalledTimes(count);
+    if (count > 0) {
+      expect(f.receipts).toEqual([
+        {
+          requestId: "approval-1",
+          responder: {
+            authenticator: "test",
+            issuer: "test",
+            principalId: "user-1",
+            principalType: "user",
+          },
+        },
+      ]);
+    }
+    if (principalId === "foreign") {
+      expect(
+        getApprovalAuditState(result.session.state).settlements
+      ).toHaveLength(0);
+    }
+  }
+);
+
+it.each([
+  ["cancel", "approve", 0],
+  ["approve", "cancel", 1],
+] as const)("winner %s defeats later %s", async (first, second, count) => {
+  const f = resumeFixture();
+  const ctx = createApprovalContext();
+  const auth = fixtureAuth(ctx);
+  let result = await contextStorage.run(
+    ctx,
+    async () =>
+      await f.runtime(pendingSession(), {
+        attributedInputResponses: [
+          { auth, response: { requestId: "approval-1", optionId: first } },
+          { auth, response: { requestId: "approval-1", optionId: second } },
+        ],
+      })
+  );
+  // oxlint-disable eslint/no-await-in-loop -- Each harness continuation consumes the previous result and cannot run concurrently.
+  for (let i = 0; i < 3 && typeof result.next === "function"; i += 1) {
+    const { next, session: currentSession } = result;
+    result = await contextStorage.run(
+      createApprovalContext(),
+      async () => await next(structuredClone(currentSession))
+    );
+  }
+  // oxlint-enable eslint/no-await-in-loop
+  expect(f.effect).toHaveBeenCalledTimes(count);
+  const audit = getApprovalAuditState(result.session.state);
+  expect(audit.settlements).toHaveLength(1);
+  expect(audit.settlements[0]?.outcome).toBe(
+    first === "approve" ? "allowed" : "cancelled"
+  );
+  expect(
+    audit.candidateHistory.some(
+      (c) => c.status === "stale" && c.decision === second
+    )
+  ).toBe(true);
+});
+
+const batch = {
+  event: { sequence: 1, stepIndex: 1, turnId: "turn-1" },
+  inputs: [{ outcome: "approved" as const, request }],
+};
+it.each([
+  "call",
+  "tool",
+  "input",
+  "session",
+  "missing-settlement",
+  "cancelled",
+  "duplicate",
+  "historical-only",
+  "reused",
+  "new-context",
+] as const)("no receipt for %s", (kind) => {
+  const ctx = createApprovalContext();
+  const { state } = settleDirectApprovalResponse({
+    actor: fixtureAuth(ctx),
+    outcome: kind === "cancelled" ? "cancelled" : "allowed",
+    requestId: "approval-1",
+    settledAt: 1,
+    state: undefined,
+  });
+  prepareToolApprovalReceipts(
+    ctx,
+    "generate-approval-resume-session",
+    kind === "historical-only"
+      ? []
+      : Array.from({ length: kind === "duplicate" ? 2 : 1 }, () => batch),
+    kind === "missing-settlement" ? undefined : state
+  );
+  if (kind === "session") {
+    ctx.set(SessionKey, { ...ctx.require(SessionKey), sessionId: "other" });
+  }
+  contextStorage.run(
+    kind === "new-context" ? createApprovalContext() : ctx,
+    () => {
+      if (kind === "reused") {
+        expect(
+          getToolApprovalReceipt("call-1", "mcp", { value: 1 })
+        ).toBeDefined();
+      }
+      expect(
+        getToolApprovalReceipt(
+          kind === "call" ? "other" : "call-1",
+          kind === "tool" ? "other" : "mcp",
+          kind === "input" ? { value: 2 } : { value: 1 }
+        )
+      ).toBeUndefined();
+    }
+  );
+});
+it("receipt captures input and responder immutably, independent of object key order", () => {
+  const ctx = createApprovalContext();
+  const auth = fixtureAuth(ctx);
+  const { state } = settleDirectApprovalResponse({
+    actor: auth,
+    outcome: "allowed",
+    requestId: "approval-1",
+    settledAt: 1,
+    state: undefined,
+  });
+  const input = { a: 1, b: 2 };
+  const prepared = {
+    ...batch,
+    inputs: [
+      {
+        outcome: "approved" as const,
+        request: { ...request, action: { ...request.action, input } },
+      },
+    ],
+  };
+  prepareToolApprovalReceipts(
+    ctx,
+    "generate-approval-resume-session",
+    [prepared],
+    state
+  );
+  input.a = 3;
+  contextStorage.run(ctx, () => {
+    const receipt = getToolApprovalReceipt("call-1", "mcp", { b: 2, a: 1 });
+    expect(receipt?.responder).toEqual({
+      authenticator: "test",
+      issuer: "test",
+      principalId: "user-1",
+      principalType: "user",
+    });
+    expect(Object.isFrozen(receipt)).toBe(true);
+    expect(Object.isFrozen(receipt?.responder)).toBe(true);
+  });
+});
+
+const readCheckpoint = (filename: string): HarnessSession => {
+  const value: unknown = JSON.parse(readFileSync(filename, "utf-8"));
+  return z
+    .looseObject({
+      sessionId: z.string(),
+      continuationToken: z.string(),
+      agent: z.custom<HarnessSession["agent"]>((candidate: unknown) =>
+        isDeepStrictEqual(candidate, session().agent)
+      ),
+      compaction: z.looseObject({
+        recentWindowSize: z.number(),
+        threshold: z.number(),
+      }),
+      history: z
+        .array(
+          z.custom<ModelMessage>(
+            (candidate: unknown) =>
+              modelMessageSchema.safeParse(candidate).success
+          )
+        )
+        .transform(validateHarnessModelMessages),
+      state: z.record(z.string(), z.unknown()).optional(),
+    })
+    .parse(value);
+};
+const checkpoint = process.env.LANE_B_CHECKPOINT;
+const checkpointPhase = process.env.LANE_B_PHASE;
+it.skipIf(checkpoint === undefined)("process checkpoint", async () => {
+  if (checkpoint === undefined) {
+    throw new Error("Checkpoint path is required");
+  }
+  const ctx = createApprovalContext();
+  const f = resumeFixture();
+  if (checkpointPhase === "ingest") {
+    const result = await contextStorage.run(
+      ctx,
+      async () =>
+        await f.runtime(pendingSession(), {
+          attributedInputResponses: [
+            {
+              auth: fixtureAuth(ctx),
+              response: { requestId: "approval-1", optionId: "approve" },
+            },
+          ],
+        })
+    );
+    // oxlint-enable eslint/no-await-in-loop
+    expect(f.effect).not.toHaveBeenCalled();
+    expect(
+      getApprovalAuditState(result.session.state).activeCandidates
+    ).toHaveLength(1);
+    writeFileSync(checkpoint, JSON.stringify(result.session));
+  } else if (checkpointPhase === "settle") {
+    const saved = readCheckpoint(checkpoint);
+    const tools: HarnessToolMap = new Map([
+      [
+        "mcp",
+        {
+          name: "mcp",
+          description: "test",
+          inputSchema: jsonSchema({ type: "object" }),
+          approval: {
+            request: () => "user-approval" as const,
+            response: ({ response }) =>
+              response.principal.principalId === "user-1" &&
+              response.principal.issuer === "test" &&
+              response.principal.authenticator === "test"
+                ? { status: "allowed" as const }
+                : { status: "rejected" as const, reason: "owner only" },
+          },
+        },
+      ],
+    ]);
+    const result = await contextStorage.run(
+      ctx,
+      async () => await coordinateApprovalDelivery({ session: saved, tools })
+    );
+    expect(
+      getApprovalAuditState(result.session.state).settlements[0]?.outcome
+    ).toBe("allowed");
+    // oxlint-enable eslint/no-await-in-loop
+    expect(f.effect).not.toHaveBeenCalled();
+    writeFileSync(checkpoint, JSON.stringify(result.session));
+  } else if (checkpointPhase === "execute") {
+    const saved = readCheckpoint(checkpoint);
+    await contextStorage.run(ctx, async () => await f.runtime(saved));
+    // oxlint-enable eslint/no-await-in-loop
+    expect(f.effect).toHaveBeenCalledOnce();
+    expect(f.receipts[0]?.responder.principalId).toBe("user-1");
+  }
+});
+
+it("aborted executor blocks the effect despite exact receipt", async () => {
+  const ctx = createApprovalContext();
+  const { state } = settleDirectApprovalResponse({
+    actor: fixtureAuth(ctx),
+    outcome: "allowed",
+    requestId: "approval-1",
+    settledAt: 1,
+    state: undefined,
+  });
+  prepareToolApprovalReceipts(
+    ctx,
+    "generate-approval-resume-session",
+    [batch],
+    state
+  );
+  const effect = vi.fn();
+  const controller = new AbortController();
+  controller.abort(new Error("cancelled"));
+  const execute = createToolExecuteWithAuth({
+    scope: "mcp",
+    // oxlint-disable-next-line eslint/require-await -- The cancellation assertion requires an asynchronous rejection, not a synchronous throw.
+    execute: async (_input, toolContext) => {
+      expect(toolContext.approval).toBeDefined();
+      toolContext.abortSignal.throwIfAborted();
+      effect();
+    },
+  });
+  await contextStorage.run(ctx, async () => {
+    await expect(
+      execute(
+        { value: 1 },
+        { toolCallId: "call-1", messages: [], abortSignal: controller.signal }
+      )
+    ).rejects.toThrow("cancelled");
+  });
+  expect(effect).not.toHaveBeenCalled();
+});
+it("new harness step clears leftover authority even on an early park", async () => {
+  const ctx = createApprovalContext();
+  const { state } = settleDirectApprovalResponse({
+    actor: fixtureAuth(ctx),
+    outcome: "allowed",
+    requestId: "approval-1",
+    settledAt: 1,
+    state: undefined,
+  });
+  prepareToolApprovalReceipts(
+    ctx,
+    "generate-approval-resume-session",
+    [batch],
+    state
+  );
+  const f = resumeFixture();
