+import { AsyncLocalStorage } from "node:async_hooks";
+import type { HarnessToolDefinition } from "#harness/execute-tool.js";
+import type { HarnessToolMap, SessionStateMap } from "#harness/types.js";
+import { isDeepStrictEqual } from "node:util";
+import { contextStorage } from "#context/container.js";
+import type { AlsContext } from "#context/container.js";
+import { ContextKey } from "#context/key.js";
+import {
+  SessionKey,
+  SessionDynamicToolMetadataKey,
+  TurnDynamicToolMetadataKey,
+  StepDynamicToolMetadataKey,
+} from "#context/keys.js";
+import { getApprovalAuditState } from "#harness/approval-candidates.js";
+import type { ApprovalResponderIdentity } from "#harness/approval-candidates.js";
+import type { ResolvedInputBatch } from "#harness/input-request-resolution.js";
+
+export interface ToolApprovalReceipt {
+  readonly requestId: string;
+  readonly responder: ApprovalResponderIdentity;
+}
+
+interface Entry {
+  readonly input: unknown;
+  readonly definition?: HarnessToolDefinition;
+  consumed?: boolean;
+  readonly dynamicIdentity: unknown;
+  readonly receipt: ToolApprovalReceipt;
+  readonly sessionId: string;
+  readonly toolName: string;
+}
+
+const executingBinding = new AsyncLocalStorage<Entry>();
+
+const ToolApprovalReceiptsKey = new ContextKey<Map<string, Entry>>(
+  "eve.runtime.toolApprovalReceipts"
+);
+
+/** Discovery can reuse a name for another closure while resuming approval. */
+const dynamicIdentity = (ctx: AlsContext, toolName: string): unknown =>
+  [
+    SessionDynamicToolMetadataKey,
+    TurnDynamicToolMetadataKey,
+    StepDynamicToolMetadataKey,
+  ].map((key) =>
+    (ctx.get(key) ?? []).filter((metadata) => metadata.name === toolName)
+  );
+
+/** Only approvals resolved in this harness invocation can authorize execution. */
+export const prepareToolApprovalReceipts = (
+  ctx: AlsContext,
+  sessionId: string,
+  batches?: readonly ResolvedInputBatch[],
+  state?: SessionStateMap,
+  tools?: HarnessToolMap
+): void => {
+  const { settlements } = getApprovalAuditState(state);
+  const receipts = new Map<string, Entry>();
+  const seen = new Set<string>();
+  for (const batch of batches ?? []) {
+    for (const input of batch.inputs) {
+      const { request } = input;
+      if (request.kind !== "tool-approval") {
+        continue;
+      }
+      const { callId } = request.action;
+      if (seen.has(callId)) {
+        receipts.delete(callId);
+        continue;
+      }
+      seen.add(callId);
+      if (input.outcome !== "approved") {
+        continue;
+      }
+      if (
+        tools !== undefined &&
+        tools.get(request.action.toolName)?.execute === undefined
+      ) {
+        continue;
+      }
+      const matches = settlements.filter(
+        (entry) => entry.requestId === request.requestId
+      );
+      if (matches.length !== 1 || matches[0]?.outcome !== "allowed") {
+        continue;
+      }
+      receipts.set(callId, {
+        input: structuredClone(request.action.input),
+        definition: tools?.get(request.action.toolName),
+        dynamicIdentity: structuredClone(
+          dynamicIdentity(ctx, request.action.toolName)
+        ),
+        receipt: Object.freeze({
+          requestId: request.requestId,
+          responder: Object.freeze({ ...matches[0].actor }),
+        }),
+        sessionId,
+        toolName: request.action.toolName,
+      });
+    }
+  }
+  ctx.setVirtualContext(ToolApprovalReceiptsKey, receipts);
+};
+
+export const getToolApprovalReceipt = (
+  callId: string,
+  toolName: string,
+  input: unknown
+): ToolApprovalReceipt | undefined => {
+  const ctx = contextStorage.getStore();
+  if (ctx === undefined) {
+    return undefined;
+  }
+  const entry = ctx.get(ToolApprovalReceiptsKey)?.get(callId);
+  if (
+    entry === undefined ||
+    entry.consumed === true ||
+    entry.sessionId !== ctx.require(SessionKey).sessionId ||
+    entry.toolName !== toolName ||
+    !isDeepStrictEqual(entry.input, input) ||
+    (entry.definition === undefined
+      ? !isDeepStrictEqual(
+          entry.dynamicIdentity,
+          dynamicIdentity(ctx, toolName)
+        )
+      : executingBinding.getStore() !== entry)
+  ) {
+    return undefined;
+  }
+  // A replay rebuilds this ephemeral map; another callback in this invocation cannot reuse it.
+  entry.consumed = true;
+  return entry.receipt;
+};
+
+/** Resolve only the pending call; a same-named newly generated call keeps discovery's definition. */
+export const approvedToolDefinition = (
+  callId: string | undefined,
+  toolName: string
+): HarnessToolDefinition | undefined => {
+  if (callId === undefined) {
+    return undefined;
+  }
+  const ctx = contextStorage.getStore();
+  if (ctx === undefined) {
+    return undefined;
+  }
+  const entry = ctx.get(ToolApprovalReceiptsKey)?.get(callId);
+  if (entry === undefined) {
+    return undefined;
+  }
+  if (
+    entry.sessionId !== ctx.require(SessionKey).sessionId ||
+    entry.toolName !== toolName
+  ) {
+    throw new Error("Approved tool continuation identity changed.");
+  }
+  return entry.definition;
+};
+
+/** Bind receipt issuance to the exact runtime-selected executor, not ambient discovery metadata. */
+export const executeApprovedBinding = <T>(
+  callId: string,
+  definition: HarnessToolDefinition,
+  input: unknown,
+  execute: () => T
+): T => {
+  const entry = contextStorage
+    .getStore()
+    ?.get(ToolApprovalReceiptsKey)
+    ?.get(callId);
+  if (entry?.definition === undefined) {
+    return execute();
+  }
+  if (
+    entry.consumed === true ||
+    entry.definition !== definition ||
+    !isDeepStrictEqual(entry.input, input)
+  ) {
+    throw new Error("Approved tool continuation input or binding changed.");
+  }
+  return executingBinding.run(entry, execute);
+};
