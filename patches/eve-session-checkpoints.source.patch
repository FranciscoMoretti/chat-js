+  expect(result).toMatchObject({ fork });
+});
+it.each([{ checkpointId: "../invalid" }, { extra: true }])("rejects malformed named forks or unknown fields %j", (extra) => {
+  const result = parseCreateBody({ message: "follow-up", fork: { sessionId: "source", beforeTurnId: "turn_1", ...extra } });
