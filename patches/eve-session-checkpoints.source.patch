+import { z } from "#compiled/zod/index.js";
+import type {
+  DeliverHookPayload,
+  SessionCommand,
+  SessionTimeoutHookPayload,
+} from "#channel/types.js";
+import { jsonObjectSchema } from "#shared/json-schemas.js";
+import {
+  sessionInboxWireV7Schema,
+  encodeSessionCommandV7,
+} from "#execution/wire/session-inbox-wire.v7.js";
+
+const previous = sessionInboxWireV7Schema.options;
+const version = z.literal(8);
+const payload = previous[0].shape.payload.extend({ messageMetadata: jsonObjectSchema.optional() });
+
+/** Version 8 preserves application-owned user message metadata. */
+export const sessionInboxWireV8Schema = z.discriminatedUnion("kind", [
+  previous[0].extend({ version, payload, payloads: z.array(payload) }),
+  previous[1].extend({ version }),
+  previous[2].extend({ version }),
+  previous[3].extend({ version }),
+  previous[4].extend({ version }),
+  previous[5].extend({ version }),
+  previous[6].extend({ version }),
+]);
+export type SessionInboxWireV8 = z.infer<typeof sessionInboxWireV8Schema>;
+
+export function encodeSessionCommandV8(
+  command: DeliverHookPayload | SessionCommand | SessionTimeoutHookPayload,
+): SessionInboxWireV8 {
+  return sessionInboxWireV8Schema.parse({ ...encodeSessionCommandV7(command), version: 8 });
+}
