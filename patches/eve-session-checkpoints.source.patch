+import { expect, it } from "vitest";
+import { sessionInboxWire as producer } from "#execution/wire/session-inbox-encoder.js";
+import { sessionInboxWire } from "#execution/wire/session-inbox-wire.js";
+const request = { kind: "checkpoint" as const, checkpointId: "00000000-0000-4000-8000-000000000001", beforeTurnId: "turn_1" };
+it("preserves immutable checkpoint coordinates on wire7 and rejects old consumers", () => {
+  expect(sessionInboxWire.decode(producer.encode(request, { version: 7 }))).toEqual(request);
+  expect(() => producer.encode(request, { version: 6 })).toThrow("require session inbox wire version 7");
+  expect(() => sessionInboxWire.decode({ ...request, version: 7, checkpointId: "../bad" })).toThrow("Invalid idle checkpoint");
+});
+
+// A payload's declared version is part of its persisted meaning. Migration
+// must not turn an unsupported historic command into a new control operation.
+it.each([undefined, 0, 1, 2, 3, 4, 5, 6])("rejects checkpoint commands declared as historic wire %s", (version) => {
+  const payload = version === undefined ? request : { ...request, version };
+  expect(() => sessionInboxWire.decode(payload)).toThrow();
+});
