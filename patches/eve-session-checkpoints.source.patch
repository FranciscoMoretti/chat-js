--- /dev/null
+++ b/packages/eve/src/execution/wire/session-inbox-wire.v7.ts
@@ -0,0 +1,16 @@
+import { z } from "#compiled/zod/index.js";
+import type { DeliverHookPayload, SessionCommand, SessionTimeoutHookPayload } from "#channel/types.js";
+import { sessionInboxWireV6Schema, encodeSessionCommandV6 } from "#execution/wire/session-inbox-wire.v6.js";
+export const sessionInboxWireV7Schema = z.discriminatedUnion("kind", [
+  sessionInboxWireV6Schema.options[0].extend({ version: z.literal(7) }),
+  sessionInboxWireV6Schema.options[1].extend({ version: z.literal(7) }),
+  sessionInboxWireV6Schema.options[2].extend({ version: z.literal(7) }),
+  sessionInboxWireV6Schema.options[3].extend({ version: z.literal(7) }),
+  sessionInboxWireV6Schema.options[4].extend({ version: z.literal(7) }),
+  sessionInboxWireV6Schema.options[5].extend({ version: z.literal(7) }),
+  z.object({ version: z.literal(7), kind: z.literal("checkpoint"), checkpointId: z.string().uuid(), beforeTurnId: z.string().regex(/^turn_(0|[1-9][0-9]*)$/) }).strict(),
+]);
+export type SessionInboxWireV7 = z.infer<typeof sessionInboxWireV7Schema>;
+export function encodeSessionCommandV7(command: DeliverHookPayload | SessionCommand | SessionTimeoutHookPayload): SessionInboxWireV7 {
+  return sessionInboxWireV7Schema.parse(command.kind === "checkpoint" ? { ...command, version: 7 } : { ...encodeSessionCommandV6(command), version: 7 });
+}
