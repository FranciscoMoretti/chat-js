@@ -0,0 +1,16 @@
+import type { VersionMigration } from "./chain.js";
+
+/** v1 writers could drop birth identity, so migration must not certify their history. */
+export const snapshotV1ToV2: VersionMigration = {
+  from: 1,
+  to: 2,
+  migrate(prior: unknown) {
+    if (typeof prior !== "object" || prior === null || !("session" in prior) ||
+        typeof prior.session !== "object" || prior.session === null || Array.isArray(prior.session)) {
+      throw new Error("durable session snapshot: invalid version 1 session.");
+    }
+    const session = { ...prior.session } as Record<string, unknown>;
+    delete session.localSandboxIdentity;
+    return { ...prior, version: 2, session };
+  },
+};
