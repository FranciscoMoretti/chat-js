+    const stream = Object.assign(new ReadableStream<unknown>({ cancel }), {
+      getTailIndex: () => (stall === "tail" ? new Promise<number>(() => {}) : Promise.resolve(0)),
+    });
+    mocks.getRun.mockReturnValue({ getReadable: () => stream });
