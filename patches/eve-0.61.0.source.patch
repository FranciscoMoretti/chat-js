+    {
+      type: "file",
+      url: "https://owned.example/report.pdf",
+      mediaType: "application/pdf",
+      filename: "report.pdf",
+    },
+  ]);
+});
+
+it.each(
+  [
+    [{ role: "assistant", content: [call] }],
+    [{ role: "tool", content: [result] }],
+    [
+      { role: "assistant", content: [call] },
+      { role: "tool", content: [{ ...result, toolCallId: "wrong" }] },
+    ],
