+function checkpoint(): SessionCheckpoint {
+  return {
+    version: 1,
+    sessionId: "source",
+    beforeTurnId: "turn_0",
+    snapshot: {
+      version: 2,
+      session: {
+        sessionId: "source",
+        continuationToken: "",
+        history: [],
+        agent: { system: "current" },
+      },
