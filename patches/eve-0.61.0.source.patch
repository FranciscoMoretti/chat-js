+import { expect, it } from "vitest";
+import { decodeSessionInboxPayload } from "#execution/session-inbox/protocol.js";
+it("roundtrips metadata through durable inbox JSON without treating it as authentication", () => {
+  const command = {
+    kind: "send" as const,
+    auth: null,
