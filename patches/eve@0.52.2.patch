--- /dev/null
+++ b/dist/src/context/tool-approval-receipts.js
@@ -0,0 +1,40 @@
+import { isDeepStrictEqual } from "node:util";
+import { loadContext } from "#context/container.js";
+import { ContextKey } from "#context/key.js";
+import { SessionKey } from "#context/keys.js";
+import { getApprovalAuditState } from "#harness/approval-candidates.js";
+
+const ToolApprovalReceiptsKey = new ContextKey("eve.runtime.toolApprovalReceipts");
+
+/** Only approvals resolved in this harness invocation can authorize execution. */
+export function prepareToolApprovalReceipts(ctx, sessionId, batches, state) {
+  const settlements = getApprovalAuditState(state).settlements;
+  const receipts = new Map();
+  const seen = new Set();
+  for (const batch of batches ?? []) {
+    for (const input of batch.inputs) {
+      const request = input.request;
+      if (request.kind !== "tool-approval") continue;
+      const callId = request.action.callId;
+      if (seen.has(callId)) { receipts.delete(callId); continue; }
+      seen.add(callId);
+      if (input.outcome !== "approved") continue;
+      const matches = settlements.filter(entry => entry.requestId === request.requestId);
+      if (matches.length !== 1 || matches[0].outcome !== "allowed") continue;
+      receipts.set(callId, {
+        sessionId,
+        input: structuredClone(request.action.input),
+        toolName: request.action.toolName,
+        receipt: Object.freeze({ requestId: request.requestId, responder: Object.freeze({...matches[0].actor}) }),
+      });
+    }
+  }
+  ctx.setVirtualContext(ToolApprovalReceiptsKey, receipts);
+}
+
+export function getToolApprovalReceipt(callId, toolName, input) {
+  const ctx = loadContext();
+  const entry = ctx.get(ToolApprovalReceiptsKey)?.get(callId);
+  if (!entry || entry.sessionId !== ctx.require(SessionKey).sessionId || entry.toolName !== toolName || !isDeepStrictEqual(entry.input, input)) return undefined;
+  return entry.receipt;
+}
