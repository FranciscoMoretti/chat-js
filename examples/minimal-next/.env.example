# Node 24+; separate disposable database for this example.
APP_DATABASE_URL=postgres://127.0.0.1:55479/m07
WORKFLOW_POSTGRES_URL=postgres://127.0.0.1:55479/m07
WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# Generate two independent random secrets, at least 32 bytes each.
APP_IDENTITY_SECRET=
EVE_GATEWAY_SECRET=
